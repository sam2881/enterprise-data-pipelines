# =============================================================================
# AI Agent Platform - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials!
#
# Architecture: Kafka + Local Airflow + Unified Dockerfile
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=dev  # dev, qa, prod

# =============================================================================
# LLM PROVIDERS (Required - at least one)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# =============================================================================
# DATABASES (Docker defaults work locally)
# =============================================================================
# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=agentdb

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Neo4j
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=adminadmin

# =============================================================================
# KAFKA (Event Bus - System of Record)
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=ai-agent

# =============================================================================
# AIRFLOW (Local DAG Orchestration)
# =============================================================================
# Fernet key for encrypting connections (generate new: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=81HqDtbqAywKSOumSha3BhWNOdQ26slT6K0YaZeZyPs=

# Airflow REST API (for Data Agent)
AIRFLOW_API_URL=http://airflow:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin123
AIRFLOW_DAGS_FOLDER=/opt/airflow/dags

# =============================================================================
# SERVICENOW MCP SERVER (Optional - for incident management)
# =============================================================================
SNOW_INSTANCE_URL=https://your-instance.service-now.com
SNOW_USERNAME=your-username
SNOW_PASSWORD=your-password
SNOW_POLL_INTERVAL=60  # seconds between polls

# =============================================================================
# JIRA MCP SERVER (Optional - for pipeline requests)
# =============================================================================
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=DATA
JIRA_PIPELINE_LABEL=pipeline-request
JIRA_POLL_INTERVAL=120  # seconds between polls

# =============================================================================
# GITHUB (Optional - for PR creation and workflow execution)
# =============================================================================
GITHUB_TOKEN=ghp_your-github-token
GITHUB_ORG=your-org
GITHUB_REPO=your-data-pipelines-repo

# GitHub Webhook Secret (for receiving workflow completion events)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Remediation repo (for shell/ansible/terraform scripts)
GITHUB_REMEDIATION_OWNER=sam2881
GITHUB_REMEDIATION_REPO=test_01
GITHUB_REMEDIATION_TOKEN=ghp_your-remediation-token

# Pipelines repo (for DAG/Spark deployment)
GITHUB_PIPELINES_OWNER=sam2881
GITHUB_PIPELINES_REPO=enterprise-data-pipelines
GITHUB_PIPELINES_TOKEN=ghp_your-pipelines-token

# =============================================================================
# GCP CONFIGURATION (Optional - for production)
# =============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCP_CREDENTIALS_PATH=./infrastructure/gcp-key.json

# GCS Buckets (Medallion Architecture)
GCS_BUCKET_RAW=${GCP_PROJECT_ID}-raw
GCS_BUCKET_BRONZE=${GCP_PROJECT_ID}-bronze
GCS_BUCKET_SILVER=${GCP_PROJECT_ID}-silver
GCS_BUCKET_GOLD=${GCP_PROJECT_ID}-gold
GCS_BUCKET_TEMP=${GCP_PROJECT_ID}-temp

# BigQuery
BIGQUERY_DATASET=data_warehouse
BIGQUERY_LOCATION=US

# Cloud Composer (for GCP production - use GitHub Actions to sync)
# COMPOSER_ENVIRONMENT=data-agent-composer
# COMPOSER_LOCATION=us-central1

# =============================================================================
# OBSERVABILITY
# =============================================================================
# Langfuse (LLM observability)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=http://langfuse:3000

# OpenTelemetry (tracing)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=ai-agent-platform

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# SLACK (Optional - for notifications)
# =============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_CHANNEL=#ai-agent-alerts

# =============================================================================
# SECURITY
# =============================================================================
# NextAuth (for Langfuse)
NEXTAUTH_SECRET=change-this-secret-in-production
SALT=change-this-salt-in-production

{
  "title": "AI Agent Platform Dashboard",
  "uid": "ai-agent-main",
  "panels": [
    {"id": 1, "title": "Requests/sec", "type": "stat", "targets": [{"expr": "rate(aiagent_requests_total[5m])"}], "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}},
    {"id": 2, "title": "Active Incidents", "type": "stat", "targets": [{"expr": "aiagent_incidents_active"}], "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}},
    {"id": 3, "title": "LLM Cost ($)", "type": "stat", "targets": [{"expr": "aiagent_llm_cost_dollars_total"}], "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}},
    {"id": 4, "title": "Pending Approvals", "type": "stat", "targets": [{"expr": "aiagent_approvals_pending"}], "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}},
    {"id": 5, "title": "LLM Latency", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.95, rate(aiagent_llm_latency_seconds_bucket[5m]))", "legendFormat": "p95"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}},
    {"id": 6, "title": "Token Usage", "type": "timeseries", "targets": [{"expr": "sum by (model) (rate(aiagent_llm_tokens_total[5m]))", "legendFormat": "{{model}}"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}},
    {"id": 7, "title": "Circuit Breaker States", "type": "stat", "targets": [{"expr": "aiagent_circuit_breaker_state", "legendFormat": "{{service}}"}], "gridPos": {"h": 6, "w": 24, "x": 0, "y": 12}},
    {"id": 8, "title": "Errors by Component", "type": "timeseries", "targets": [{"expr": "sum by (component) (rate(aiagent_errors_total[5m]))", "legendFormat": "{{component}}"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18}},
    {"id": 9, "title": "RAG Query Latency", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.95, rate(aiagent_rag_latency_seconds_bucket[5m]))", "legendFormat": "p95"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18}}
  ],
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"}
}

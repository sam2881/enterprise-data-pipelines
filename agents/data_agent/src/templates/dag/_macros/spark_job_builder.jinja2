{#
Spark Job Builder Macro - Build Dataproc job configurations
#}

{%- macro dataproc_pyspark_job(main_file, args=[], properties={}) -%}
DataprocSubmitJobOperator(
    task_id='{{ caller().strip() if caller else "spark_job" }}',
    project_id=PROJECT_ID,
    region=GCP_REGION,
    job={
        "placement": {"cluster_name": DATAPROC_CLUSTER},
        "pyspark_job": {
            "main_python_file_uri": f"gs://{COMPOSER_BUCKET}/spark_jobs/{{ main_file }}",
            "args": [
                {%- for arg in args %}
                "{{ arg }}",
                {%- endfor %}
                f"--project={PROJECT_ID}",
                f"--domain={DOMAIN}",
                f"--product={PRODUCT_CODE}",
                f"--env={ENVIRONMENT}",
                f"--execution_date={{{{ ds }}}}",
            ],
            "properties": {
                "spark.executor.memory": "{{ spark_executor_memory | default('4g') }}",
                "spark.executor.cores": "{{ spark_executor_cores | default('2') }}",
                "spark.executor.instances": "{{ spark_executor_instances | default('2') }}",
                "spark.driver.memory": "{{ spark_driver_memory | default('4g') }}",
                "spark.sql.shuffle.partitions": "{{ spark_shuffle_partitions | default('200') }}",
                "spark.sql.adaptive.enabled": "true",
                "spark.sql.adaptive.coalescePartitions.enabled": "true",
                "spark.dynamicAllocation.enabled": "{{ spark_dynamic_allocation | default('true') }}",
                {%- for key, value in properties.items() %}
                "{{ key }}": "{{ value }}",
                {%- endfor %}
            },
        },
    },
    gcp_conn_id="{{ gcp_conn_id | default('google_cloud_default') }}",
)
{%- endmacro -%}

{%- macro python_task(task_id, python_callable, op_kwargs={}) -%}
@task(task_id='{{ task_id }}')
def {{ task_id }}(**context):
    """Auto-generated task: {{ task_id }}"""
    from datetime import datetime
    import json

    execution_date = context['execution_date'].strftime('%Y-%m-%d')
    {%- for key, value in op_kwargs.items() %}
    {{ key }} = {{ value | tojson }}
    {%- endfor %}

    # Task implementation injected from metadata
    {{ caller() | indent(4) }}
{%- endmacro -%}

{%- macro bigquery_operator(task_id, sql, destination_table=None, write_disposition='WRITE_APPEND') -%}
BigQueryInsertJobOperator(
    task_id='{{ task_id }}',
    configuration={
        "query": {
            "query": """{{ sql }}""",
            "useLegacySql": False,
            {%- if destination_table %}
            "destinationTable": {
                "projectId": PROJECT_ID,
                "datasetId": BQ_DATASET,
                "tableId": "{{ destination_table }}",
            },
            "writeDisposition": "{{ write_disposition }}",
            {%- endif %}
        }
    },
    gcp_conn_id="{{ gcp_conn_id | default('google_cloud_default') }}",
)
{%- endmacro -%}

{%- macro gcs_to_bigquery(task_id, source_uri, destination_table, source_format='NEWLINE_DELIMITED_JSON', schema_fields=None) -%}
GCSToBigQueryOperator(
    task_id='{{ task_id }}',
    bucket=GOLD_BUCKET,
    source_objects=[f"{SOURCE_PATH}/{{{{ ds }}}}/{{ source_uri }}"],
    destination_project_dataset_table=f"{PROJECT_ID}.{BQ_DATASET}.{{ destination_table }}",
    source_format='{{ source_format }}',
    {%- if schema_fields %}
    schema_fields={{ schema_fields | tojson }},
    {%- else %}
    autodetect=True,
    {%- endif %}
    write_disposition='{{ write_disposition | default("WRITE_APPEND") }}',
    create_disposition='CREATE_IF_NEEDED',
    gcp_conn_id="{{ gcp_conn_id | default('google_cloud_default') }}",
)
{%- endmacro -%}

{#
Natural Language Transformation Macro
Supports: Complex transformations, joins, aggregations via natural language
LLM converts NL to PySpark/SQL at generation time
#}

{%- macro nl_transform_task(zone, nl_description) -%}
@task(task_id='{{ zone }}_nl_transform')
def {{ zone }}_nl_transform(input_data: dict, **context) -> dict:
    """
    Natural Language Transformation: {{ zone | upper }}

    Description: {{ nl_description }}

    Generated PySpark code from NL description.
    This code was generated by LLM at DAG creation time.
    """
    from pyspark.sql import SparkSession, functions as F
    from pyspark.sql.window import Window
    import json

    spark = SparkSession.builder.appName("{{ dag_id }}_{{ zone }}_transform").getOrCreate()

    # Load input data
    input_path = input_data.get('output_path', f"gs://{BRONZE_BUCKET}/{SOURCE_PATH}")
    df = spark.read.json(input_path)

    logger.info(f"NL Transform [{{ zone }}]: {{ nl_description }}")
    logger.info(f"Input records: {df.count()}")

    # =========================================================================
    # LLM-GENERATED TRANSFORMATION CODE
    # Original NL: "{{ nl_description }}"
    # =========================================================================
    {{ caller() | indent(4) }}
    # =========================================================================
    # END LLM-GENERATED CODE
    # =========================================================================

    # Write output
    execution_date = context['execution_date'].strftime('%Y-%m-%d')
    output_path = f"gs://{{'SILVER_BUCKET' if zone == 'silver' else 'GOLD_BUCKET'}}/{SOURCE_PATH}/{execution_date}"

    df.write.mode('overwrite').json(output_path)

    logger.info(f"Output records: {df.count()}")
    logger.info(f"Output path: {output_path}")

    return {
        'output_path': output_path,
        'record_count': df.count(),
        'transformation': '{{ nl_description[:100] }}',
    }
{%- endmacro -%}

{%- macro join_transform(join_config) -%}
{#
Join Transform Macro
join_config: {
    "left_table": "customers",
    "right_table": "orders",
    "join_type": "left",
    "join_keys": [{"left": "customer_id", "right": "cust_id"}],
    "select_columns": ["customers.*", "orders.order_total", "orders.order_date"]
}
#}
@task(task_id='join_{{ join_config.left_table }}_{{ join_config.right_table }}')
def join_{{ join_config.left_table }}_{{ join_config.right_table }}(**context) -> dict:
    """
    Join Transform: {{ join_config.left_table }} {{ join_config.join_type | upper }} JOIN {{ join_config.right_table }}
    Keys: {{ join_config.join_keys | map(attribute='left') | join(', ') }}
    """
    from pyspark.sql import SparkSession, functions as F

    spark = SparkSession.builder.appName("{{ dag_id }}_join").getOrCreate()
    execution_date = context['execution_date'].strftime('%Y-%m-%d')

    # Load tables
    left_df = spark.read.json(f"gs://{SILVER_BUCKET}/{{ join_config.left_source | default(join_config.left_table) }}/{execution_date}")
    right_df = spark.read.json(f"gs://{SILVER_BUCKET}/{{ join_config.right_source | default(join_config.right_table) }}/{execution_date}")

    # Build join condition
    join_condition = {% for key in join_config.join_keys -%}
        (left_df["{{ key.left }}"] == right_df["{{ key.right }}"]){% if not loop.last %} & {% endif %}
    {%- endfor %}

    # Perform join
    joined_df = left_df.join(
        right_df,
        on=join_condition,
        how="{{ join_config.join_type | default('left') }}"
    )

    {%- if join_config.select_columns %}
    # Select specific columns
    joined_df = joined_df.select(
        {%- for col in join_config.select_columns %}
        "{{ col }}",
        {%- endfor %}
    )
    {%- endif %}

    # Handle column conflicts (suffix duplicate columns)
    for col in joined_df.columns:
        if joined_df.columns.count(col) > 1:
            # Rename duplicates
            pass  # PySpark handles this automatically

    output_path = f"gs://{GOLD_BUCKET}/{{ join_config.output_table | default(join_config.left_table ~ '_' ~ join_config.right_table) }}/{execution_date}"
    joined_df.write.mode('overwrite').json(output_path)

    return {
        'output_path': output_path,
        'record_count': joined_df.count(),
        'join_type': '{{ join_config.join_type }}',
    }
{%- endmacro -%}

{%- macro aggregation_transform(agg_config) -%}
{#
Aggregation Transform Macro
agg_config: {
    "group_by": ["region", "product_category"],
    "aggregations": [
        {"column": "sales_amount", "function": "sum", "alias": "total_sales"},
        {"column": "order_id", "function": "count", "alias": "order_count"},
        {"column": "unit_price", "function": "avg", "alias": "avg_price"}
    ],
    "having": "total_sales > 1000",
    "order_by": [{"column": "total_sales", "direction": "desc"}]
}
#}
@task(task_id='aggregate_{{ agg_config.output_table | default("aggregated") }}')
def aggregate_{{ agg_config.output_table | default("aggregated") }}(input_data: dict, **context) -> dict:
    """
    Aggregation Transform
    Group By: {{ agg_config.group_by | join(', ') }}
    Aggregations: {{ agg_config.aggregations | map(attribute='alias') | join(', ') }}
    """
    from pyspark.sql import SparkSession, functions as F

    spark = SparkSession.builder.appName("{{ dag_id }}_aggregate").getOrCreate()

    input_path = input_data.get('output_path')
    df = spark.read.json(input_path)

    # Perform aggregation
    agg_df = df.groupBy(
        {%- for col in agg_config.group_by %}
        "{{ col }}",
        {%- endfor %}
    ).agg(
        {%- for agg in agg_config.aggregations %}
        F.{{ agg.function }}("{{ agg.column }}").alias("{{ agg.alias }}"),
        {%- endfor %}
    )

    {%- if agg_config.having %}
    # Apply HAVING filter
    agg_df = agg_df.filter("{{ agg_config.having }}")
    {%- endif %}

    {%- if agg_config.order_by %}
    # Apply ordering
    agg_df = agg_df.orderBy(
        {%- for order in agg_config.order_by %}
        F.col("{{ order.column }}").{{ 'desc' if order.direction == 'desc' else 'asc' }}(),
        {%- endfor %}
    )
    {%- endif %}

    execution_date = context['execution_date'].strftime('%Y-%m-%d')
    output_path = f"gs://{GOLD_BUCKET}/{{ agg_config.output_table | default('aggregated') }}/{execution_date}"
    agg_df.write.mode('overwrite').json(output_path)

    return {
        'output_path': output_path,
        'record_count': agg_df.count(),
    }
{%- endmacro -%}

{%- macro window_transform(window_config) -%}
{#
Window Function Transform
window_config: {
    "partition_by": ["customer_id"],
    "order_by": [{"column": "order_date", "direction": "desc"}],
    "functions": [
        {"type": "row_number", "alias": "order_rank"},
        {"type": "lag", "column": "order_total", "offset": 1, "alias": "prev_order_total"},
        {"type": "sum", "column": "order_total", "alias": "running_total"}
    ]
}
#}
@task(task_id='window_transform')
def window_transform(input_data: dict, **context) -> dict:
    """
    Window Transform
    Partition By: {{ window_config.partition_by | join(', ') }}
    """
    from pyspark.sql import SparkSession, functions as F
    from pyspark.sql.window import Window

    spark = SparkSession.builder.appName("{{ dag_id }}_window").getOrCreate()

    input_path = input_data.get('output_path')
    df = spark.read.json(input_path)

    # Define window specification
    window_spec = Window.partitionBy(
        {%- for col in window_config.partition_by %}
        "{{ col }}",
        {%- endfor %}
    ).orderBy(
        {%- for order in window_config.order_by %}
        F.col("{{ order.column }}").{{ 'desc' if order.direction == 'desc' else 'asc' }}(),
        {%- endfor %}
    )

    # Apply window functions
    {%- for func in window_config.functions %}
    {%- if func.type == 'row_number' %}
    df = df.withColumn("{{ func.alias }}", F.row_number().over(window_spec))
    {%- elif func.type == 'rank' %}
    df = df.withColumn("{{ func.alias }}", F.rank().over(window_spec))
    {%- elif func.type == 'dense_rank' %}
    df = df.withColumn("{{ func.alias }}", F.dense_rank().over(window_spec))
    {%- elif func.type == 'lag' %}
    df = df.withColumn("{{ func.alias }}", F.lag("{{ func.column }}", {{ func.offset | default(1) }}).over(window_spec))
    {%- elif func.type == 'lead' %}
    df = df.withColumn("{{ func.alias }}", F.lead("{{ func.column }}", {{ func.offset | default(1) }}).over(window_spec))
    {%- elif func.type == 'sum' %}
    df = df.withColumn("{{ func.alias }}", F.sum("{{ func.column }}").over(window_spec.rowsBetween(Window.unboundedPreceding, Window.currentRow)))
    {%- elif func.type == 'avg' %}
    df = df.withColumn("{{ func.alias }}", F.avg("{{ func.column }}").over(window_spec.rowsBetween(-{{ func.window_size | default(7) }}, 0)))
    {%- endif %}
    {%- endfor %}

    execution_date = context['execution_date'].strftime('%Y-%m-%d')
    output_path = f"gs://{GOLD_BUCKET}/{{ window_config.output_table | default('windowed') }}/{execution_date}"
    df.write.mode('overwrite').json(output_path)

    return {'output_path': output_path, 'record_count': df.count()}
{%- endmacro -%}

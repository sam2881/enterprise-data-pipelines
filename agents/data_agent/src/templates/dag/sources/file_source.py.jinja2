with DAG(
    dag_id='{{ dag_id }}',
    default_args=default_args,
    description='File ingestion: {{ source_format | upper }} -> Medallion -> BigQuery',
    schedule_interval='{{ schedule_interval | default(None) }}',
    start_date=datetime({{ start_year | default(2024) }}, {{ start_month | default(1) }}, {{ start_day | default(1) }}),
    catchup={{ catchup | default(False) }},
    max_active_runs={{ max_active_runs | default(1) }},
    tags={{ tags | default(['file-ingestion', source_format, domain_name]) | tojson }},
) as dag:

    start = EmptyOperator(task_id='start')
    end = EmptyOperator(task_id='end', trigger_rule=TriggerRule.ALL_DONE)

    # =========================================================================
    # LANDING ZONE
    # =========================================================================
    with TaskGroup('landing_zone') as landing_zone:

        @task(task_id='list_source_files')
        def list_source_files(**context) -> List[str]:
            """List files matching pattern in source bucket."""
            from google.cloud import storage
            import fnmatch

            execution_date = context['execution_date'].strftime('%Y-%m-%d')
            client = storage.Client(project=PROJECT_ID)
            bucket = client.bucket(SOURCE_BUCKET)

            prefix = f"{SOURCE_PREFIX}/{execution_date}/" if '{{ partition_by_date | default(True) }}' == 'True' else f"{SOURCE_PREFIX}/"
            blobs = bucket.list_blobs(prefix=prefix)

            files = []
            for blob in blobs:
                if fnmatch.fnmatch(blob.name, f"*{FILE_PATTERN.replace('*', '')}"):
                    files.append(blob.name)

            if not files:
                logger.warning(f"No files found matching {FILE_PATTERN} in {SOURCE_BUCKET}/{prefix}")
                {%- if fail_on_empty | default(False) %}
                raise AirflowFailException("No source files found")
                {%- endif %}

            logger.info(f"Found {len(files)} files to process")
            return files

        @task(task_id='ingest_files')
        def ingest_files(file_list: List[str], **context) -> Dict:
            """Read and parse all source files."""
            from google.cloud import storage

            client = storage.Client(project=PROJECT_ID)
            bucket = client.bucket(SOURCE_BUCKET)

            all_records = []
            file_metadata = []

            parser_map = {
                'csv': FileParser.parse_csv,
                'tsv': FileParser.parse_csv,
                'json': FileParser.parse_json,
                'ndjson': FileParser.parse_json,
                'xml': FileParser.parse_xml,
                'fixed_width': FileParser.parse_fixed_width,
                'ebcdic': FileParser.parse_ebcdic,
                'excel': FileParser.parse_excel,
                'xlsx': FileParser.parse_excel,
                'xls': FileParser.parse_excel,
                'parquet': FileParser.parse_parquet,
                'avro': FileParser.parse_avro,
            }

            parser = parser_map.get(SOURCE_FORMAT, FileParser.parse_json)

            for file_path in file_list:
                try:
                    blob = bucket.blob(file_path)
                    content = blob.download_as_bytes()

                    records = parser(content)
                    all_records.extend(records)

                    file_metadata.append({
                        'file': file_path,
                        'size_bytes': blob.size,
                        'records': len(records),
                    })
                    logger.info(f"Parsed {len(records)} records from {file_path}")

                except Exception as e:
                    logger.error(f"Failed to parse {file_path}: {e}")
                    {%- if fail_on_parse_error | default(True) %}
                    raise
                    {%- endif %}

            return {
                'records': all_records,
                'metadata': {
                    'total_records': len(all_records),
                    'files_processed': len(file_metadata),
                    'file_details': file_metadata,
                },
            }

        files = list_source_files()
        ingest_result = ingest_files(files)

    # =========================================================================
    # BRONZE ZONE
    # =========================================================================
    with TaskGroup('bronze_zone') as bronze_zone:

        @task(task_id='write_bronze')
        def write_bronze(ingest_result: Dict, **context) -> Dict:
            """Write raw records to Bronze layer with audit columns."""
            from google.cloud import storage
            from datetime import datetime as dt

            records = ingest_result['records']
            execution_date = context['execution_date'].strftime('%Y-%m-%d')

            # Add audit columns
            for i, record in enumerate(records):
                record['_ingestion_timestamp'] = dt.utcnow().isoformat()
                record['_source_format'] = SOURCE_FORMAT
                record['_execution_date'] = execution_date
                record['_batch_id'] = f"{{ dag_id }}_{execution_date}_{i}"

            # Write to Bronze
            bronze_path = f"{SOURCE_PATH}/{execution_date}/data.json"
            client = storage.Client(project=PROJECT_ID)
            bucket = client.bucket(BRONZE_BUCKET)
            blob = bucket.blob(bronze_path)

            ndjson = '\n'.join(json.dumps(r, default=str) for r in records)
            blob.upload_from_string(ndjson, content_type='application/json')

            logger.info(f"Wrote {len(records)} records to Bronze: gs://{BRONZE_BUCKET}/{bronze_path}")

            return {
                'records': records,
                'bronze_path': f"gs://{BRONZE_BUCKET}/{bronze_path}",
                'record_count': len(records),
            }

        bronze_result = write_bronze(ingest_result)

    # =========================================================================
    # SILVER ZONE
    # =========================================================================
    with TaskGroup('silver_zone') as silver_zone:

        @task(task_id='transform_silver')
        def transform_silver(bronze_result: Dict, **context) -> Dict:
            """Apply transformations and write to Silver."""
            records = bronze_result['records']
            execution_date = context['execution_date'].strftime('%Y-%m-%d')

            # Deduplicate by primary keys
            seen = {}
            for record in records:
                pk = tuple(record.get(k) for k in PRIMARY_KEYS)
                seen[pk] = record  # Last wins
            records = list(seen.values())

            {%- if transformations %}
            # Apply configured transformations
            for record in records:
                {%- for transform in transformations %}
                {%- if transform.type == 'rename' %}
                if '{{ transform.source }}' in record:
                    record['{{ transform.target }}'] = record.pop('{{ transform.source }}')
                {%- elif transform.type == 'cast' %}
                if '{{ transform.column }}' in record:
                    try:
                        record['{{ transform.column }}'] = {{ transform.cast_type }}(record['{{ transform.column }}'])
                    except (ValueError, TypeError):
                        pass
                {%- elif transform.type == 'derive' %}
                record['{{ transform.column }}'] = {{ transform.expression }}
                {%- elif transform.type == 'default' %}
                if record.get('{{ transform.column }}') is None:
                    record['{{ transform.column }}'] = {{ transform.default_value | tojson }}
                {%- endif %}
                {%- endfor %}
            {%- endif %}

            # Write to Silver
            from google.cloud import storage
            silver_path = f"{SOURCE_PATH}/{execution_date}/data.json"
            client = storage.Client(project=PROJECT_ID)
            bucket = client.bucket(SILVER_BUCKET)
            blob = bucket.blob(silver_path)

            ndjson = '\n'.join(json.dumps(r, default=str) for r in records)
            blob.upload_from_string(ndjson, content_type='application/json')

            logger.info(f"Wrote {len(records)} records to Silver")

            return {
                'records': records,
                'silver_path': f"gs://{SILVER_BUCKET}/{silver_path}",
                'record_count': len(records),
            }

        silver_result = transform_silver(bronze_result)

    # =========================================================================
    # QUALITY GATE
    # =========================================================================
    with TaskGroup('quality_gate') as quality_gate:

        @task(task_id='validate_quality')
        def validate_quality(silver_result: Dict, **context) -> Dict:
            """Run data quality validation."""
            records = silver_result['records']

            if not records:
                return {'score': 0, 'passed': False, 'failures': ['No records']}

            total_checks = 0
            passed_checks = 0
            failures = []

            for rule in QUALITY_RULES:
                rule_type = rule.get('rule')
                column = rule.get('column')
                severity = rule.get('severity', 'warning')

                for i, record in enumerate(records):
                    total_checks += 1
                    value = record.get(column)
                    passed = True

                    if rule_type == 'not_null':
                        passed = value is not None and value != ''
                    elif rule_type == 'unique':
                        values = [r.get(column) for r in records]
                        passed = values.count(value) == 1
                    elif rule_type == 'regex':
                        pattern = rule.get('pattern', '.*')
                        passed = bool(re.match(pattern, str(value or '')))
                    elif rule_type == 'range':
                        try:
                            num_val = float(value)
                            passed = (rule.get('min') is None or num_val >= rule['min']) and \
                                     (rule.get('max') is None or num_val <= rule['max'])
                        except (TypeError, ValueError):
                            passed = False

                    if passed:
                        passed_checks += 1
                    elif len(failures) < 100:
                        failures.append({'rule': rule_type, 'column': column, 'row': i, 'severity': severity})

            score = (passed_checks / total_checks * 100) if total_checks > 0 else 100
            critical_failures = [f for f in failures if f['severity'] == 'critical']

            result = {
                'score': round(score, 2),
                'passed': score >= MIN_QUALITY_SCORE and len(critical_failures) == 0,
                'total_checks': total_checks,
                'failures': failures[:50],
            }

            if not result['passed']:
                logger.warning(f"Quality check failed: {score}% (threshold: {MIN_QUALITY_SCORE}%)")
                if critical_failures:
                    raise AirflowFailException(f"Critical quality failures: {len(critical_failures)}")

            return {**silver_result, 'quality': result}

        quality_result = validate_quality(silver_result)

    # =========================================================================
    # GOLD ZONE
    # =========================================================================
    with TaskGroup('gold_zone') as gold_zone:

        @task(task_id='write_gold')
        def write_gold(quality_result: Dict, **context) -> Dict:
            """Write to Gold layer."""
            from google.cloud import storage

            records = quality_result['records']
            execution_date = context['execution_date'].strftime('%Y-%m-%d')

            gold_path = f"{SOURCE_PATH}/{execution_date}/data.json"
            client = storage.Client(project=PROJECT_ID)
            bucket = client.bucket(GOLD_BUCKET)
            blob = bucket.blob(gold_path)

            ndjson = '\n'.join(json.dumps(r, default=str) for r in records)
            blob.upload_from_string(ndjson, content_type='application/json')

            return {
                'gold_path': f"gs://{GOLD_BUCKET}/{gold_path}",
                'record_count': len(records),
                'quality': quality_result['quality'],
            }

        gold_result = write_gold(quality_result)

    # =========================================================================
    # BIGQUERY LOAD
    # =========================================================================
    with TaskGroup('bigquery_load') as bigquery_load:

        @task(task_id='load_bigquery')
        def load_bigquery(gold_result: Dict, **context) -> Dict:
            """Load data to BigQuery."""
            from google.cloud import bigquery

            execution_date = context['execution_date'].strftime('%Y-%m-%d')
            bq = bigquery.Client(project=PROJECT_ID)

            # Ensure dataset exists
            dataset_ref = bq.dataset(BQ_DATASET)
            try:
                bq.get_dataset(dataset_ref)
            except Exception:
                dataset = bigquery.Dataset(dataset_ref)
                dataset.location = BQ_LOCATION
                bq.create_dataset(dataset, exists_ok=True)

            table_id = f"{PROJECT_ID}.{BQ_DATASET}.{BQ_TABLE}"

            job_config = bigquery.LoadJobConfig(
                source_format=bigquery.SourceFormat.NEWLINE_DELIMITED_JSON,
                autodetect=True,
                write_disposition=bigquery.WriteDisposition.{{ 'WRITE_TRUNCATE' if load_strategy == 'overwrite' else 'WRITE_APPEND' }},
            )

            uri = gold_result['gold_path']
            load_job = bq.load_table_from_uri(uri, table_id, job_config=job_config)
            load_job.result()

            table = bq.get_table(table_id)
            logger.info(f"Loaded to BigQuery: {table_id} ({table.num_rows} total rows)")

            return {
                'table_id': table_id,
                'rows_loaded': gold_result['record_count'],
                'total_rows': table.num_rows,
            }

        bq_result = load_bigquery(gold_result)

    # =========================================================================
    # NOTIFICATIONS
    # =========================================================================
    {{ success_notification_task() }}
    {{ error_handler_task() }}

    # =========================================================================
    # TASK DEPENDENCIES
    # =========================================================================
    start >> landing_zone >> bronze_zone >> silver_zone >> quality_gate >> gold_zone >> bigquery_load >> send_success_notification() >> end
    [landing_zone, bronze_zone, silver_zone, quality_gate, gold_zone, bigquery_load] >> handle_pipeline_failure()

# =============================================================================
# PARSER FUNCTIONS
# =============================================================================

class FileParser:
    """Universal file parser supporting all enterprise formats."""

    @staticmethod
    def parse_csv(content: bytes) -> List[Dict]:
        """Parse CSV/TSV files."""
        import csv
        text = content.decode(ENCODING)
        reader = csv.DictReader(
            io.StringIO(text),
            delimiter=DELIMITER,
            quotechar=QUOTE_CHAR,
        )
        records = []
        for row in reader:
            # Handle null values
            cleaned_row = {
                k: (None if v == NULL_VALUE else v)
                for k, v in row.items()
            }
            records.append(cleaned_row)
        return records

    @staticmethod
    def parse_json(content: bytes) -> List[Dict]:
        """Parse JSON/NDJSON files."""
        text = content.decode('utf-8')

        # Try NDJSON first
        if SOURCE_FORMAT == 'ndjson' or '\n' in text.strip():
            lines = text.strip().split('\n')
            try:
                records = [json.loads(line) for line in lines if line.strip()]
                if records:
                    return records
            except json.JSONDecodeError:
                pass

        # Standard JSON
        data = json.loads(text)

        # Extract nested path if specified
        if JSON_PATH:
            for key in JSON_PATH.split('.'):
                if isinstance(data, dict):
                    data = data.get(key, data)

        return data if isinstance(data, list) else [data]

    @staticmethod
    def parse_xml(content: bytes) -> List[Dict]:
        """Parse XML files."""
        import xml.etree.ElementTree as ET

        root = ET.fromstring(content.decode('utf-8'))
        records = []

        for elem in root.findall(f'.//{ROW_TAG}'):
            record = {}
            for child in elem:
                # Handle nested elements
                if len(child) > 0:
                    record[child.tag] = {subchild.tag: subchild.text for subchild in child}
                else:
                    record[child.tag] = child.text
            records.append(record)

        return records

    @staticmethod
    def parse_fixed_width(content: bytes) -> List[Dict]:
        """Parse fixed-width files (mainframe extracts)."""
        text = content.decode(ENCODING)
        records = []

        for line in text.strip().split('\n'):
            if not line.strip():
                continue
            record = {}
            for spec in FIELD_SPECS:
                value = line[spec['start']:spec['end']].strip()
                # Type conversion
                if spec.get('type') == 'integer':
                    value = int(value) if value.isdigit() else 0
                elif spec.get('type') == 'decimal':
                    value = float(value) if value.replace('.', '').replace('-', '').isdigit() else 0.0
                record[spec['name']] = value
            records.append(record)

        return records

    @staticmethod
    def parse_ebcdic(content: bytes) -> List[Dict]:
        """Parse EBCDIC files using copybook definition."""
        # EBCDIC to ASCII translation table (simplified - use ebcdic library in prod)
        try:
            import ebcdic
            text = content.decode('cp037')  # IBM EBCDIC
        except ImportError:
            # Fallback translation table
            text = content.decode('latin-1')

        records = []
        fields = COPYBOOK.get('fields', [])

        for i in range(0, len(text), RECORD_LENGTH):
            record_text = text[i:i + RECORD_LENGTH]
            if not record_text.strip():
                continue

            record = {}
            for field in fields:
                start = field['start']
                length = field['length']
                value = record_text[start:start + length].strip()

                # Type conversion based on copybook
                field_type = field.get('type', 'string')
                if field_type == 'numeric' or field_type == 'integer':
                    value = int(value) if value.lstrip('-').isdigit() else 0
                elif field_type == 'decimal':
                    # Handle packed decimal if needed
                    decimal_places = field.get('decimal_places', 2)
                    try:
                        value = float(value) / (10 ** decimal_places)
                    except ValueError:
                        value = 0.0
                elif field_type == 'date':
                    # Parse date format from copybook
                    date_format = field.get('format', '%Y%m%d')
                    try:
                        from datetime import datetime as dt
                        value = dt.strptime(value, date_format).isoformat()
                    except ValueError:
                        value = None

                record[field['name']] = value
            records.append(record)

        return records

    @staticmethod
    def parse_excel(content: bytes) -> List[Dict]:
        """Parse Excel files (.xlsx, .xls)."""
        import pandas as pd

        df = pd.read_excel(
            io.BytesIO(content),
            sheet_name=SHEET_NAME or 0,
            skiprows=SKIP_ROWS,
            usecols=USE_COLS,
        )

        # Convert NaN to None
        df = df.where(pd.notnull(df), None)

        return df.to_dict('records')

    @staticmethod
    def parse_parquet(content: bytes) -> List[Dict]:
        """Parse Parquet files."""
        import pyarrow.parquet as pq
        table = pq.read_table(io.BytesIO(content))
        return table.to_pylist()

    @staticmethod
    def parse_avro(content: bytes) -> List[Dict]:
        """Parse Avro files."""
        import fastavro
        reader = fastavro.reader(io.BytesIO(content))
        return [record for record in reader]



with DAG(
    dag_id='{{ dag_id }}',
    default_args=default_args,
    description='Streaming ingestion: {{ streaming_type | upper }} -> Medallion -> BigQuery',
    schedule_interval='{{ schedule_interval | default("*/5 * * * *") }}',
    start_date=datetime({{ start_year | default(2024) }}, {{ start_month | default(1) }}, {{ start_day | default(1) }}),
    catchup=False,  # Never catchup for streaming
    max_active_runs=1,  # Only one instance at a time
    tags={{ tags | default(['streaming', streaming_type, event_type, domain_name]) | tojson }},
) as dag:

    start = EmptyOperator(task_id='start')
    end = EmptyOperator(task_id='end', trigger_rule=TriggerRule.ALL_DONE)

    # =========================================================================
    # CONSUME EVENTS
    # =========================================================================
    with TaskGroup('consume_events') as consume_events:

        @task(task_id='consume_from_source')
        def consume_from_source(**context) -> Dict:
            """Consume events from streaming source."""
            logger.info(f"Consuming from {STREAMING_TYPE}: max {MAX_MESSAGES} messages")

            if STREAMING_TYPE == 'kafka':
                messages = StreamingConsumer.consume_kafka(
                    KAFKA_BOOTSTRAP_SERVERS, KAFKA_TOPIC, KAFKA_CONSUMER_GROUP,
                    MAX_MESSAGES, POLL_TIMEOUT_SECONDS
                )
            elif STREAMING_TYPE == 'pubsub':
                messages = StreamingConsumer.consume_pubsub(
                    PUBSUB_PROJECT, PUBSUB_SUBSCRIPTION,
                    MAX_MESSAGES, POLL_TIMEOUT_SECONDS
                )
            elif STREAMING_TYPE == 'kinesis':
                messages = StreamingConsumer.consume_kinesis(
                    '{{ kinesis_stream }}', MAX_MESSAGES
                )
            else:
                raise ValueError(f"Unknown streaming type: {STREAMING_TYPE}")

            if not messages:
                logger.info("No messages to process")
                return {'records': [], 'message_count': 0}

            # Parse events based on type
            parser_map = {
                'generic': EventParser.parse_generic,
                'iot': EventParser.parse_iot,
                'clickstream': EventParser.parse_clickstream,
                'transaction': EventParser.parse_transaction,
                'log': EventParser.parse_log,
            }
            parser = parser_map.get(EVENT_TYPE, EventParser.parse_generic)
            records = parser(messages)

            logger.info(f"Consumed {len(messages)} messages, parsed {len(records)} records")

            return {
                'records': records,
                'message_count': len(messages),
                'record_count': len(records),
            }

        consume_result = consume_from_source()

    # =========================================================================
    # BRONZE ZONE
    # =========================================================================
    with TaskGroup('bronze_zone') as bronze_zone:

        @task(task_id='write_bronze')
        def write_bronze(consume_result: Dict, **context) -> Dict:
            """Write to Bronze layer."""
            from google.cloud import storage

            records = consume_result['records']
            if not records:
                return {'records': [], 'bronze_path': None}

            execution_time = datetime.utcnow()
            partition = execution_time.strftime('%Y-%m-%d/%H')

            # Add audit columns
            for record in records:
                record['_ingestion_timestamp'] = execution_time.isoformat()
                record['_source_type'] = STREAMING_TYPE
                record['_event_type'] = EVENT_TYPE

            # Write to Bronze
            bronze_path = f"{SOURCE_PATH}/{partition}/data.json"
            client = storage.Client(project=PROJECT_ID)
            bucket = client.bucket(BRONZE_BUCKET)
            blob = bucket.blob(bronze_path)

            ndjson = '\n'.join(json.dumps(r, default=str) for r in records)
            blob.upload_from_string(ndjson, content_type='application/json')

            return {
                'records': records,
                'bronze_path': f"gs://{BRONZE_BUCKET}/{bronze_path}",
                'record_count': len(records),
            }

        bronze_result = write_bronze(consume_result)

    # =========================================================================
    # SILVER + GOLD + BQ
    # =========================================================================
    with TaskGroup('process_and_load') as process_and_load:

        @task(task_id='process_to_bigquery')
        def process_to_bigquery(bronze_result: Dict, **context) -> Dict:
            """Process Silver/Gold and load to BigQuery."""
            from google.cloud import bigquery, storage

            records = bronze_result['records']
            if not records:
                return {'status': 'skipped', 'reason': 'No records'}

            # Deduplicate
            seen = {}
            for record in records:
                pk = tuple(record.get(k) for k in PRIMARY_KEYS)
                seen[pk] = record
            records = list(seen.values())

            execution_time = datetime.utcnow()
            partition = execution_time.strftime('%Y-%m-%d/%H')

            # Write to Silver
            client = storage.Client(project=PROJECT_ID)
            silver_path = f"{SOURCE_PATH}/{partition}/data.json"
            silver_bucket = client.bucket(SILVER_BUCKET)
            silver_blob = silver_bucket.blob(silver_path)
            ndjson = '\n'.join(json.dumps(r, default=str) for r in records)
            silver_blob.upload_from_string(ndjson, content_type='application/json')

            # Write to Gold
            gold_bucket = client.bucket(GOLD_BUCKET)
            gold_blob = gold_bucket.blob(silver_path)
            gold_blob.upload_from_string(ndjson, content_type='application/json')

            # Load to BigQuery
            bq = bigquery.Client(project=PROJECT_ID)

            dataset_ref = bq.dataset(BQ_DATASET)
            try:
                bq.get_dataset(dataset_ref)
            except Exception:
                dataset = bigquery.Dataset(dataset_ref)
                dataset.location = BQ_LOCATION
                bq.create_dataset(dataset, exists_ok=True)

            table_id = f"{PROJECT_ID}.{BQ_DATASET}.{BQ_TABLE}"
            job_config = bigquery.LoadJobConfig(
                source_format=bigquery.SourceFormat.NEWLINE_DELIMITED_JSON,
                autodetect=True,
                write_disposition=bigquery.WriteDisposition.WRITE_APPEND,
            )

            import io
            load_job = bq.load_table_from_file(
                io.BytesIO(ndjson.encode()),
                table_id,
                job_config=job_config,
            )
            load_job.result()

            table = bq.get_table(table_id)

            return {
                'table_id': table_id,
                'rows_loaded': len(records),
                'total_rows': table.num_rows,
            }

        bq_result = process_to_bigquery(bronze_result)

    # =========================================================================
    # NOTIFICATIONS
    # =========================================================================
    {{ success_notification_task() }}
    {{ error_handler_task() }}

    # =========================================================================
    # DEPENDENCIES
    # =========================================================================
    start >> consume_events >> bronze_zone >> process_and_load >> send_success_notification() >> end
    [consume_events, bronze_zone, process_and_load] >> handle_pipeline_failure()

class StreamingConsumer:
    """Universal streaming consumer for all sources."""

    @staticmethod
    def consume_kafka(bootstrap_servers: str, topic: str, consumer_group: str,
                      max_messages: int, timeout_seconds: int) -> List[Dict]:
        """Consume messages from Kafka topic."""
        from kafka import KafkaConsumer
        import time

        consumer = KafkaConsumer(
            topic,
            bootstrap_servers=bootstrap_servers,
            group_id=consumer_group,
            auto_offset_reset=KAFKA_AUTO_OFFSET_RESET,
            enable_auto_commit=False,
            value_deserializer=lambda m: json.loads(m.decode('utf-8')),
            max_poll_records=min(max_messages, 500),
            consumer_timeout_ms=timeout_seconds * 1000,
            {%- if kafka_security_protocol == 'SASL_SSL' %}
            security_protocol=KAFKA_SECURITY_PROTOCOL,
            sasl_mechanism=KAFKA_SASL_MECHANISM,
            {%- endif %}
        )

        messages = []
        start_time = time.time()

        try:
            while len(messages) < max_messages and (time.time() - start_time) < timeout_seconds:
                batch = consumer.poll(timeout_ms=1000, max_records=500)
                for tp, records in batch.items():
                    for record in records:
                        messages.append({
                            'key': record.key.decode('utf-8') if record.key else None,
                            'value': record.value,
                            'partition': record.partition,
                            'offset': record.offset,
                            'timestamp': record.timestamp,
                            'topic': record.topic,
                        })
                        if len(messages) >= max_messages:
                            break

            consumer.commit()
        finally:
            consumer.close()

        return messages

    @staticmethod
    def consume_pubsub(project_id: str, subscription_id: str,
                       max_messages: int, timeout_seconds: int) -> List[Dict]:
        """Consume messages from Google Pub/Sub."""
        from google.cloud import pubsub_v1
        from concurrent.futures import TimeoutError
        import time

        subscriber = pubsub_v1.SubscriberClient()
        subscription_path = subscriber.subscription_path(project_id, subscription_id)

        messages = []
        ack_ids = []

        def callback(message):
            messages.append({
                'data': json.loads(message.data.decode('utf-8')),
                'attributes': dict(message.attributes),
                'message_id': message.message_id,
                'publish_time': message.publish_time.isoformat(),
            })
            ack_ids.append(message.ack_id)

        streaming_pull_future = subscriber.subscribe(subscription_path, callback=callback)

        try:
            streaming_pull_future.result(timeout=timeout_seconds)
        except TimeoutError:
            streaming_pull_future.cancel()

        # Acknowledge messages
        if ack_ids:
            subscriber.acknowledge(request={"subscription": subscription_path, "ack_ids": ack_ids})

        return messages

    @staticmethod
    def consume_kinesis(stream_name: str, max_messages: int, region: str = 'us-east-1') -> List[Dict]:
        """Consume records from AWS Kinesis."""
        import boto3

        client = boto3.client('kinesis', region_name=region)
        response = client.describe_stream(StreamName=stream_name)
        shard_ids = [shard['ShardId'] for shard in response['StreamDescription']['Shards']]

        messages = []
        for shard_id in shard_ids:
            shard_iterator = client.get_shard_iterator(
                StreamName=stream_name,
                ShardId=shard_id,
                ShardIteratorType='TRIM_HORIZON',
            )['ShardIterator']

            while shard_iterator and len(messages) < max_messages:
                response = client.get_records(ShardIterator=shard_iterator, Limit=100)
                for record in response['Records']:
                    messages.append({
                        'data': json.loads(record['Data'].decode('utf-8')),
                        'sequence_number': record['SequenceNumber'],
                        'partition_key': record['PartitionKey'],
                        'approximate_arrival': record['ApproximateArrivalTimestamp'].isoformat(),
                    })
                shard_iterator = response.get('NextShardIterator')

        return messages


class EventParser:
    """Parse different event types into normalized records."""

    @staticmethod
    def parse_generic(messages: List[Dict]) -> List[Dict]:
        """Parse generic events."""
        return [msg.get('value', msg.get('data', msg)) for msg in messages]

    @staticmethod
    def parse_iot(messages: List[Dict]) -> List[Dict]:
        """Parse IoT telemetry events."""
        records = []
        for msg in messages:
            data = msg.get('value', msg.get('data', {}))
            record = {
                'device_id': data.get(DEVICE_ID_FIELD),
                'event_timestamp': msg.get('timestamp') or data.get('timestamp'),
                'received_at': datetime.utcnow().isoformat(),
            }
            # Extract telemetry fields
            for field in TELEMETRY_FIELDS:
                record[field] = data.get(field)

            # Add metadata
            record['metadata'] = json.dumps({
                k: v for k, v in data.items()
                if k not in [DEVICE_ID_FIELD, 'timestamp'] + TELEMETRY_FIELDS
            })
            records.append(record)
        return records

    @staticmethod
    def parse_clickstream(messages: List[Dict]) -> List[Dict]:
        """Parse clickstream events."""
        records = []
        for msg in messages:
            data = msg.get('value', msg.get('data', {}))
            records.append({
                'session_id': data.get(SESSION_ID_FIELD),
                'user_id': data.get(USER_ID_FIELD),
                'event_type': data.get('event_type', 'page_view'),
                'page_url': data.get('page_url', data.get('url')),
                'referrer': data.get('referrer'),
                'user_agent': data.get('user_agent'),
                'ip_address': data.get('ip_address', data.get('ip')),
                'event_timestamp': msg.get('timestamp') or data.get('timestamp'),
                'properties': json.dumps(data.get('properties', {})),
            })
        return records

    @staticmethod
    def parse_transaction(messages: List[Dict]) -> List[Dict]:
        """Parse financial transaction events."""
        records = []
        for msg in messages:
            data = msg.get('value', msg.get('data', {}))
            records.append({
                'transaction_id': data.get('transaction_id', data.get('txn_id')),
                'account_id': data.get('account_id'),
                'transaction_type': data.get('type', data.get('transaction_type')),
                'amount': float(data.get('amount', 0)),
                'currency': data.get('currency', 'USD'),
                'status': data.get('status'),
                'merchant': data.get('merchant'),
                'category': data.get('category'),
                'timestamp': msg.get('timestamp') or data.get('timestamp'),
            })
        return records

    @staticmethod
    def parse_log(messages: List[Dict]) -> List[Dict]:
        """Parse log events."""
        records = []
        for msg in messages:
            data = msg.get('value', msg.get('data', {}))
            if isinstance(data, str):
                # Parse log line
                records.append({
                    'log_line': data,
                    'timestamp': msg.get('timestamp'),
                    'source': msg.get('topic', msg.get('subscription')),
                })
            else:
                records.append({
                    'level': data.get('level', data.get('severity', 'INFO')),
                    'message': data.get('message', data.get('msg')),
                    'logger': data.get('logger', data.get('name')),
                    'timestamp': data.get('timestamp', msg.get('timestamp')),
                    'trace_id': data.get('trace_id'),
                    'span_id': data.get('span_id'),
                    'extra': json.dumps({k: v for k, v in data.items()
                                        if k not in ['level', 'message', 'logger', 'timestamp']}),
                })
        return records



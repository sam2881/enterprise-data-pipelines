with DAG(
    dag_id="{{ dag_id }}",
    default_args=default_args,
    description="API ingestion pipeline for {{ product_code }} - {{ domain }}",
    schedule="{{ schedule | default(None) }}",
    start_date=datetime.strptime("{{ start_date | default('2024-01-01') }}", "%Y-%m-%d"),
    catchup={{ catchup | default(False) }},
    max_active_runs={{ max_active_runs | default(1) }},
    tags={{ tags | default(['data-platform', 'api-ingest', domain, product_code]) | tojson }},
    doc_md=__doc__,
    render_template_as_native_obj=True,
) as dag:

    start = EmptyOperator(task_id="start")
    end = EmptyOperator(task_id="end", trigger_rule=TriggerRule.ALL_DONE)

    # =========================================================================
    # Pre-Check: API Health
    # =========================================================================

    with TaskGroup(group_id="pre_checks") as pre_checks:

        {% if api_health_endpoint %}
        check_api_health = HttpSensor(
            task_id="check_api_health",
            http_conn_id=API_CONN_ID,
            endpoint="{{ api_health_endpoint }}",
            response_check=lambda response: response.status_code == 200,
            poke_interval=30,
            timeout=300,
        )
        {% else %}
        @task(task_id="check_api_health")
        def check_api_health() -> Dict[str, Any]:
            """Verify API is accessible."""
            client = APIClient(API_BASE_URL, API_AUTH_TYPE, API_HEADERS)

            try:
                # Make a lightweight request to verify connectivity
                response = client.fetch_rest(API_ENDPOINT, params={'limit': 1})
                return {"status": "healthy", "sample_response_keys": list(response.keys())[:5]}
            except Exception as e:
                logger.error(f"API health check failed: {e}")
                raise

        check_api_health_task = check_api_health()
        {% endif %}

        @task(task_id="get_last_watermark")
        def get_last_watermark(**context) -> str:
            """Get the last successful watermark for incremental loading."""
            if not INCREMENTAL_FIELD:
                return ""

            from airflow.providers.postgres.hooks.postgres import PostgresHook

            try:
                hook = PostgresHook(postgres_conn_id=METADATA_DB_CONN_ID)
                result = hook.get_first("""
                    SELECT watermark_value
                    FROM pipeline_watermarks
                    WHERE dag_id = %s AND environment = %s
                    ORDER BY updated_at DESC
                    LIMIT 1
                """, parameters=(dag.dag_id, ENVIRONMENT))

                if result and result[0]:
                    return result[0]
            except Exception as e:
                logger.warning(f"Could not get watermark: {e}")

            # Default: lookback period
            lookback = datetime.utcnow() - timedelta(hours=INCREMENTAL_LOOKBACK_HOURS)
            return lookback.isoformat()

        watermark_task = get_last_watermark()

    # =========================================================================
    # Extract: Fetch Data from API
    # =========================================================================

    with TaskGroup(group_id="extract") as extract:

        @task(task_id="fetch_api_data")
        def fetch_api_data(watermark: str, **context) -> Dict[str, Any]:
            """
            Fetch data from API with pagination handling.

            Returns:
                Dict with output_path and record_count
            """
            from google.cloud import storage
            import json

            execution_date = context['execution_date'].strftime('%Y-%m-%d')
            client = APIClient(API_BASE_URL, API_AUTH_TYPE, API_HEADERS)

            all_records = []
            page_count = 0

            # Build request params
            params = {}
            if watermark and INCREMENTAL_FIELD:
                params[INCREMENTAL_FIELD + '_gte'] = watermark

            {% if api_type == 'graphql' %}
            # GraphQL fetching
            variables = {'limit': PAGE_SIZE}
            if watermark and INCREMENTAL_FIELD:
                variables[INCREMENTAL_FIELD] = watermark

            for response in client.fetch_paginated(query=GRAPHQL_QUERY, variables=variables):
                data = client._extract_path(response, RESPONSE_PATH)
                if data:
                    if isinstance(data, list):
                        all_records.extend(data)
                    else:
                        all_records.append(data)
                page_count += 1
                logger.info(f"Fetched page {page_count}, total records: {len(all_records)}")
            {% else %}
            # REST fetching
            for response in client.fetch_paginated(endpoint=API_ENDPOINT, params=params):
                data = client._extract_path(response, RESPONSE_PATH)
                if data:
                    if isinstance(data, list):
                        all_records.extend(data)
                    else:
                        all_records.append(data)
                page_count += 1
                logger.info(f"Fetched page {page_count}, total records: {len(all_records)}")
            {% endif %}

            if not all_records:
                logger.warning("No records fetched from API")
                return {'output_path': None, 'record_count': 0, 'pages': 0}

            # Write to GCS Landing
            storage_client = storage.Client()
            bucket = storage_client.bucket(LANDING_BUCKET)

            output_path = f"{SOURCE_PATH}/{execution_date}/data.json"
            blob = bucket.blob(output_path)

            # Write as newline-delimited JSON for better Spark processing
            ndjson = '\n'.join(json.dumps(record) for record in all_records)
            blob.upload_from_string(ndjson, content_type='application/json')

            logger.info(f"Wrote {len(all_records)} records to gs://{LANDING_BUCKET}/{output_path}")

            # Track new watermark if incremental
            new_watermark = None
            if INCREMENTAL_FIELD and all_records:
                watermarks = [
                    r.get(INCREMENTAL_FIELD)
                    for r in all_records
                    if r.get(INCREMENTAL_FIELD)
                ]
                if watermarks:
                    new_watermark = max(watermarks)

            return {
                'output_path': f"gs://{LANDING_BUCKET}/{output_path}",
                'record_count': len(all_records),
                'pages': page_count,
                'new_watermark': new_watermark,
            }

        @task(task_id="validate_response_schema")
        def validate_response_schema(fetch_result: Dict[str, Any]) -> Dict[str, Any]:
            """
            Validate that fetched data matches expected schema.
            """
            if not fetch_result.get('output_path'):
                return {'valid': True, 'reason': 'No data to validate'}

            if not SCHEMA_FIELDS:
                return {'valid': True, 'reason': 'No schema defined'}

            from google.cloud import storage
            import json

            # Read sample of data
            storage_client = storage.Client()
            bucket_name = fetch_result['output_path'].split('/')[2]
            blob_path = '/'.join(fetch_result['output_path'].split('/')[3:])

            bucket = storage_client.bucket(bucket_name)
            blob = bucket.blob(blob_path)

            # Read first few lines
            content = blob.download_as_string().decode('utf-8')
            sample = [json.loads(line) for line in content.split('\n')[:10] if line]

            # Validate schema
            missing_fields = []
            for field_def in SCHEMA_FIELDS:
                field_name = field_def.get('name')
                required = field_def.get('required', False)

                if required:
                    for record in sample:
                        if field_name not in record:
                            missing_fields.append(field_name)
                            break

            if missing_fields:
                raise ValueError(f"Required fields missing in response: {missing_fields}")

            return {
                'valid': True,
                'records_validated': len(sample),
                'fields_checked': len(SCHEMA_FIELDS),
            }

        fetch_task = fetch_api_data(watermark_task)
        validate_task = validate_response_schema(fetch_task)

    # =========================================================================
    # Transform: Bronze → Silver → Gold
    # =========================================================================

    with TaskGroup(group_id="bronze_zone") as bronze_zone:

        @task(task_id="bronze_ingest")
        def bronze_ingest(fetch_result: Dict[str, Any], **context) -> Dict[str, Any]:
            """
            Ingest API data to Bronze zone.

            - Parse JSON
            - Add metadata columns
            - Write as Parquet
            """
            if not fetch_result.get('output_path'):
                return {'output_path': None, 'record_count': 0}

            from pyspark.sql import SparkSession, functions as F

            spark = SparkSession.builder \
                .appName(f"{dag.dag_id}_bronze_ingest") \
                .getOrCreate()

            execution_date = context['execution_date'].strftime('%Y-%m-%d')

            # Read landing data
            df = spark.read.json(fetch_result['output_path'])

            # Add metadata columns
            df = df.withColumn("_ingestion_timestamp", F.current_timestamp())
            df = df.withColumn("_source_system", F.lit(f"api:{API_BASE_URL}"))
            df = df.withColumn("_batch_id", F.lit(context['run_id']))
            df = df.withColumn("_execution_date", F.lit(execution_date))

            # Write to Bronze
            output_path = f"gs://{PROJECT_ID}-bronze/{SOURCE_PATH}/{execution_date}"
            df.write.mode('overwrite').parquet(output_path)

            record_count = df.count()
            logger.info(f"Bronze ingest: {record_count} records to {output_path}")

            return {
                'output_path': output_path,
                'record_count': record_count,
            }

        bronze_task = bronze_ingest(fetch_task)

    with TaskGroup(group_id="silver_zone") as silver_zone:

        @task(task_id="silver_transform")
        def silver_transform(bronze_result: Dict[str, Any], **context) -> Dict[str, Any]:
            """
            Transform Bronze to Silver.

            - Apply data cleansing
            - Standardize data types
            - Handle nulls
            """
            if not bronze_result.get('output_path'):
                return {'output_path': None, 'record_count': 0}

            from pyspark.sql import SparkSession, functions as F

            spark = SparkSession.builder \
                .appName(f"{dag.dag_id}_silver_transform") \
                .getOrCreate()

            execution_date = context['execution_date'].strftime('%Y-%m-%d')

            # Read Bronze
            df = spark.read.parquet(bronze_result['output_path'])

            # Apply transformations
            {% if transformations %}
            {% for transform in transformations %}
            {% if transform.type == 'rename' %}
            df = df.withColumnRenamed("{{ transform.source }}", "{{ transform.target }}")
            {% elif transform.type == 'cast' %}
            df = df.withColumn("{{ transform.column }}", F.col("{{ transform.column }}").cast("{{ transform.data_type }}"))
            {% elif transform.type == 'filter' %}
            df = df.filter("{{ transform.condition }}")
            {% elif transform.type == 'drop_nulls' %}
            df = df.dropna(subset={{ transform.columns | tojson }})
            {% endif %}
            {% endfor %}
            {% else %}
            # Default: drop duplicates if primary key exists
            {% if primary_keys %}
            df = df.dropDuplicates({{ primary_keys | tojson }})
            {% endif %}
            {% endif %}

            # Write to Silver
            output_path = f"gs://{PROJECT_ID}-silver/{SOURCE_PATH}/{execution_date}"
            df.write.mode('overwrite').parquet(output_path)

            record_count = df.count()
            logger.info(f"Silver transform: {record_count} records to {output_path}")

            return {
                'output_path': output_path,
                'record_count': record_count,
            }

        silver_task = silver_transform(bronze_task)

    with TaskGroup(group_id="gold_zone") as gold_zone:

        @task(task_id="gold_load_bq")
        def gold_load_bq(silver_result: Dict[str, Any], **context) -> Dict[str, Any]:
            """
            Load Silver data to BigQuery Gold layer.
            """
            if not silver_result.get('output_path'):
                return {'bq_table': None, 'record_count': 0}

            from pyspark.sql import SparkSession

            spark = SparkSession.builder \
                .appName(f"{dag.dag_id}_gold_load") \
                .getOrCreate()

            # Read Silver
            df = spark.read.parquet(silver_result['output_path'])

            # Write to BigQuery
            bq_table = f"{PROJECT_ID}.{BQ_DATASET}.{BQ_TABLE}"

            df.write \
                .format("bigquery") \
                .option("table", bq_table) \
                .option("temporaryGcsBucket", f"{PROJECT_ID}-spark-temp") \
                .mode("{{ write_mode | default('append') }}") \
                .save()

            record_count = df.count()
            logger.info(f"Gold load: {record_count} records to {bq_table}")

            return {
                'bq_table': bq_table,
                'record_count': record_count,
            }

        gold_task = gold_load_bq(silver_task)

    # =========================================================================
    # Post-Processing
    # =========================================================================

    with TaskGroup(group_id="post_processing") as post_processing:

        @task(task_id="update_watermark")
        def update_watermark(fetch_result: Dict[str, Any], **context) -> Dict[str, Any]:
            """Update watermark for incremental processing."""
            new_watermark = fetch_result.get('new_watermark')
            if not new_watermark:
                return {'updated': False}

            from airflow.providers.postgres.hooks.postgres import PostgresHook

            try:
                hook = PostgresHook(postgres_conn_id=METADATA_DB_CONN_ID)
                hook.run("""
                    INSERT INTO pipeline_watermarks (dag_id, environment, watermark_value, updated_at)
                    VALUES (%s, %s, %s, NOW())
                    ON CONFLICT (dag_id, environment)
                    DO UPDATE SET watermark_value = EXCLUDED.watermark_value, updated_at = NOW()
                """, parameters=(dag.dag_id, ENVIRONMENT, new_watermark))

                return {'updated': True, 'watermark': new_watermark}
            except Exception as e:
                logger.warning(f"Failed to update watermark: {e}")
                return {'updated': False, 'error': str(e)}

        @task(task_id="log_metrics")
        def log_metrics(
            fetch_result: Dict[str, Any],
            gold_result: Dict[str, Any],
            **context
        ) -> Dict[str, Any]:
            """Log pipeline execution metrics."""
            metrics = {
                'dag_id': dag.dag_id,
                'execution_date': context['execution_date'].isoformat(),
                'records_fetched': fetch_result.get('record_count', 0),
                'pages_fetched': fetch_result.get('pages', 0),
                'records_loaded': gold_result.get('record_count', 0),
                'bq_table': gold_result.get('bq_table'),
            }

            logger.info(f"Pipeline metrics: {metrics}")

            # Push to XCom for downstream tasks
            context['ti'].xcom_push(key='pipeline_metrics', value=metrics)

            return metrics

        watermark_update = update_watermark(fetch_task)
        metrics_log = log_metrics(fetch_task, gold_task)

    # =========================================================================
    # Error Handling
    # =========================================================================

    {{ error_handler_task() }}

    {{ success_notification_task() }}

    # =========================================================================
    # Task Dependencies
    # =========================================================================

    start >> pre_checks >> extract >> bronze_zone >> silver_zone >> gold_zone >> post_processing
    post_processing >> send_success_notification()
    post_processing >> end

    # Error handler
    [extract, bronze_zone, silver_zone, gold_zone] >> handle_pipeline_failure()

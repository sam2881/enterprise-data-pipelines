# =============================================================================
# API Client Classes
# =============================================================================

class APIClient:
    """
    Unified API client supporting REST and GraphQL.

    Handles:
    - Authentication (API Key, OAuth2, Basic)
    - Rate limiting
    - Retries with exponential backoff
    - Pagination
    """

    def __init__(self, base_url: str, auth_type: str, headers: Dict[str, str]):
        self.base_url = base_url
        self.auth_type = auth_type
        self.headers = {"Content-Type": "application/json", **headers}
        self._setup_auth()
        self._last_request_time = 0

    def _setup_auth(self):
        """Setup authentication based on auth_type."""
        import requests
        from airflow.hooks.base import BaseHook

        if self.auth_type == 'api_key':
            # Get API key from Airflow connection
            try:
                conn = BaseHook.get_connection(API_CONN_ID)
                api_key = conn.password or conn.extra_dejson.get('api_key')
                key_header = conn.extra_dejson.get('key_header', 'X-API-Key')
                self.headers[key_header] = api_key
            except Exception as e:
                logger.warning(f"Could not get API key from connection: {e}")

        elif self.auth_type == 'oauth2':
            # OAuth2 token handling
            try:
                conn = BaseHook.get_connection(API_CONN_ID)
                token_url = conn.extra_dejson.get('token_url')
                client_id = conn.login
                client_secret = conn.password

                # Get access token
                response = requests.post(
                    token_url,
                    data={
                        'grant_type': 'client_credentials',
                        'client_id': client_id,
                        'client_secret': client_secret,
                    },
                    timeout=30,
                )
                response.raise_for_status()
                token = response.json().get('access_token')
                self.headers['Authorization'] = f'Bearer {token}'
            except Exception as e:
                logger.warning(f"OAuth2 setup failed: {e}")

        elif self.auth_type == 'basic':
            # Basic auth handled by requests library
            try:
                conn = BaseHook.get_connection(API_CONN_ID)
                import base64
                credentials = base64.b64encode(
                    f"{conn.login}:{conn.password}".encode()
                ).decode()
                self.headers['Authorization'] = f'Basic {credentials}'
            except Exception as e:
                logger.warning(f"Basic auth setup failed: {e}")

    def _rate_limit(self):
        """Apply rate limiting."""
        elapsed = time.time() - self._last_request_time
        min_interval = 1.0 / RATE_LIMIT_REQUESTS_PER_SECOND
        if elapsed < min_interval:
            time.sleep(min_interval - elapsed)
        self._last_request_time = time.time()

    def _request_with_retry(
        self,
        method: str,
        url: str,
        **kwargs
    ) -> Dict[str, Any]:
        """Make request with retry logic."""
        import requests

        for attempt in range(MAX_RETRIES + 1):
            try:
                self._rate_limit()

                response = requests.request(
                    method=method,
                    url=url,
                    headers=self.headers,
                    timeout=API_TIMEOUT,
                    **kwargs,
                )

                # Handle rate limit response
                if response.status_code == 429:
                    retry_after = int(response.headers.get('Retry-After', RETRY_BACKOFF_SECONDS * (attempt + 1)))
                    logger.warning(f"Rate limited. Waiting {retry_after}s...")
                    time.sleep(retry_after)
                    continue

                response.raise_for_status()
                return response.json()

            except requests.exceptions.RequestException as e:
                if attempt < MAX_RETRIES:
                    wait_time = RETRY_BACKOFF_SECONDS * (2 ** attempt)
                    logger.warning(f"Request failed, retrying in {wait_time}s: {e}")
                    time.sleep(wait_time)
                else:
                    raise

        raise RuntimeError(f"Max retries exceeded for {url}")

    def fetch_rest(
        self,
        endpoint: str,
        method: str = "GET",
        params: Dict[str, Any] = None,
        body: Dict[str, Any] = None,
    ) -> Dict[str, Any]:
        """Fetch data from REST endpoint."""
        url = f"{self.base_url}{endpoint}"
        kwargs = {}
        if params:
            kwargs['params'] = params
        if body:
            kwargs['json'] = body

        return self._request_with_retry(method, url, **kwargs)

    def fetch_graphql(
        self,
        query: str,
        variables: Dict[str, Any] = None,
    ) -> Dict[str, Any]:
        """Fetch data from GraphQL endpoint."""
        url = f"{self.base_url}{API_ENDPOINT}"
        body = {"query": query}
        if variables:
            body["variables"] = variables

        return self._request_with_retry("POST", url, json=body)

    def fetch_paginated(
        self,
        endpoint: str = None,
        query: str = None,
        variables: Dict[str, Any] = None,
        params: Dict[str, Any] = None,
    ) -> Generator[Dict[str, Any], None, None]:
        """Fetch all pages of data."""

        page = 0
        cursor = None
        offset = 0
        next_url = None

        while page < MAX_PAGES:
            # Prepare request based on pagination type
            if PAGINATION_TYPE == 'cursor':
                if cursor:
                    if API_TYPE == 'graphql':
                        variables = variables or {}
                        variables[CURSOR_PARAM] = cursor
                    else:
                        params = params or {}
                        params[CURSOR_PARAM] = cursor

            elif PAGINATION_TYPE == 'offset':
                params = params or {}
                params[OFFSET_PARAM] = offset
                params['limit'] = PAGE_SIZE

            elif PAGINATION_TYPE == 'link' and next_url:
                # For link-based pagination, use the full next URL
                if API_TYPE == 'rest':
                    response = self._request_with_retry("GET", next_url)
                    yield response
                    next_url = self._extract_path(response, NEXT_PAGE_PATH)
                    if not next_url:
                        break
                    page += 1
                    continue

            # Make request
            if API_TYPE == 'graphql':
                response = self.fetch_graphql(query, variables)
            else:
                response = self.fetch_rest(endpoint or API_ENDPOINT, API_METHOD, params)

            yield response

            # Extract data and check for more pages
            data = self._extract_path(response, RESPONSE_PATH)
            if not data or (isinstance(data, list) and len(data) == 0):
                break

            # Get next page token/cursor
            if PAGINATION_TYPE == 'cursor':
                cursor = self._extract_path(response, NEXT_PAGE_PATH)
                if not cursor:
                    break

            elif PAGINATION_TYPE == 'offset':
                offset += PAGE_SIZE
                total = self._extract_path(response, TOTAL_COUNT_PATH)
                if total and offset >= total:
                    break
                if isinstance(data, list) and len(data) < PAGE_SIZE:
                    break

            elif PAGINATION_TYPE == 'link':
                next_url = self._extract_path(response, NEXT_PAGE_PATH)
                if not next_url:
                    break

            elif PAGINATION_TYPE == 'none':
                break

            page += 1

        if page >= MAX_PAGES:
            logger.warning(f"Reached max pages limit ({MAX_PAGES})")

    @staticmethod
    def _extract_path(data: Dict[str, Any], path: str) -> Any:
        """Extract value from nested dict using dot notation path."""
        if not path:
            return data

        current = data
        for key in path.split('.'):
            if isinstance(current, dict):
                current = current.get(key)
            else:
                return None
            if current is None:
                return None
        return current



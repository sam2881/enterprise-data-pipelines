default_args = {
    'owner': '{{ owner | default("data-platform") }}',
    'depends_on_past': {{ depends_on_past | default(True if extraction_mode == 'incremental' else False) | lower }},
    'email': ALERT_EMAILS,
    'email_on_failure': True,
    'retries': {{ retries | default(2) }},
    'retry_delay': timedelta(minutes={{ retry_delay_minutes | default(5) }}),
}

with DAG(
    dag_id='{{ dag_id }}',
    default_args=default_args,
    description='Database extraction: {{ database_type | upper }} ({{ extraction_mode }}) -> BigQuery',
    schedule_interval='{{ schedule_interval | default("@daily") }}',
    start_date=datetime({{ start_year | default(2024) }}, {{ start_month | default(1) }}, {{ start_day | default(1) }}),
    catchup={{ catchup | default(False) }},
    max_active_runs={{ max_active_runs | default(1) }},
    tags={{ tags | default(['database', database_type, extraction_mode, domain_name]) | tojson }},
) as dag:

    start = EmptyOperator(task_id='start')
    end = EmptyOperator(task_id='end', trigger_rule=TriggerRule.ALL_DONE)

    # =========================================================================
    # EXTRACTION
    # =========================================================================
    with TaskGroup('extraction') as extraction:

        @task(task_id='get_watermark')
        def get_watermark(**context) -> Optional[str]:
            """Get last watermark for incremental extraction."""
            if EXTRACTION_MODE != 'incremental':
                return None

            from airflow.providers.postgres.hooks.postgres import PostgresHook
            hook = PostgresHook(postgres_conn_id=METADATA_DB_CONN_ID)

            result = hook.get_first("""
                SELECT last_watermark FROM pipeline_watermarks
                WHERE dag_id = %s AND environment = %s
            """, parameters=('{{ dag_id }}', ENVIRONMENT))

            return result[0] if result else None

        @task(task_id='extract_data')
        def extract_data(last_watermark: Optional[str], **context) -> Dict:
            """Extract data from source database."""
            conn = DatabaseExtractor.get_connection(DATABASE_TYPE, CONNECTION_ID)

            if EXTRACTION_MODE == 'full':
                records = DatabaseExtractor.extract_full(conn, SOURCE_QUERY)
            elif EXTRACTION_MODE == 'incremental':
                records = DatabaseExtractor.extract_incremental(
                    conn, SOURCE_QUERY, WATERMARK_COLUMN,
                    last_watermark or '1900-01-01 00:00:00', WATERMARK_TYPE
                )
            elif EXTRACTION_MODE == 'cdc':
                cdc_events = CDCProcessor.consume_cdc_events(
                    KAFKA_BOOTSTRAP_SERVERS, KAFKA_TOPIC, KAFKA_CONSUMER_GROUP
                )
                # Load current state from Gold layer
                try:
                    from google.cloud import storage
                    client = storage.Client(project=PROJECT_ID)
                    bucket = client.bucket(GOLD_BUCKET)
                    blob = bucket.blob(f"{SOURCE_PATH}/current/data.json")
                    current_data = json.loads(blob.download_as_string())
                except Exception:
                    current_data = []

                records = CDCProcessor.apply_cdc_to_target(current_data, cdc_events, PRIMARY_KEYS)
            else:
                raise ValueError(f"Unknown extraction mode: {EXTRACTION_MODE}")

            conn.close()

            # Track new watermark
            new_watermark = None
            if EXTRACTION_MODE == 'incremental' and records:
                new_watermark = str(max(r.get(WATERMARK_COLUMN) for r in records if r.get(WATERMARK_COLUMN)))

            logger.info(f"Extracted {len(records)} records ({EXTRACTION_MODE} mode)")

            return {
                'records': records,
                'record_count': len(records),
                'new_watermark': new_watermark,
                'extraction_mode': EXTRACTION_MODE,
            }

        watermark = get_watermark()
        extract_result = extract_data(watermark)

    # =========================================================================
    # BRONZE ZONE
    # =========================================================================
    with TaskGroup('bronze_zone') as bronze_zone:

        @task(task_id='write_bronze')
        def write_bronze(extract_result: Dict, **context) -> Dict:
            """Write extracted data to Bronze layer."""
            from google.cloud import storage
            from datetime import datetime as dt

            records = extract_result['records']
            execution_date = context['execution_date'].strftime('%Y-%m-%d')

            # Add audit columns
            for record in records:
                record['_ingestion_timestamp'] = dt.utcnow().isoformat()
                record['_source_database'] = DATABASE_TYPE
                record['_source_table'] = SOURCE_TABLE
                record['_extraction_mode'] = EXTRACTION_MODE
                record['_execution_date'] = execution_date

            # Write to Bronze
            bronze_path = f"{SOURCE_PATH}/{execution_date}/data.json"
            client = storage.Client(project=PROJECT_ID)
            bucket = client.bucket(BRONZE_BUCKET)
            blob = bucket.blob(bronze_path)

            ndjson = '\n'.join(json.dumps(r, default=str) for r in records)
            blob.upload_from_string(ndjson, content_type='application/json')

            return {
                'records': records,
                'bronze_path': f"gs://{BRONZE_BUCKET}/{bronze_path}",
                'record_count': len(records),
                'new_watermark': extract_result.get('new_watermark'),
            }

        bronze_result = write_bronze(extract_result)

    # =========================================================================
    # SILVER ZONE (With Data Model Transform)
    # =========================================================================
    with TaskGroup('silver_zone') as silver_zone:

        @task(task_id='transform_silver')
        def transform_silver(bronze_result: Dict, **context) -> Dict:
            """Transform and write to Silver layer."""
            from google.cloud import storage

            records = bronze_result['records']
            execution_date = context['execution_date'].strftime('%Y-%m-%d')

            # Deduplicate
            seen = {}
            for record in records:
                pk = tuple(record.get(k) for k in PRIMARY_KEYS)
                seen[pk] = record
            records = list(seen.values())

            {%- if destination_model == 'data_vault' %}
            # Transform to Data Vault model
            hub_keys = {{ hub_keys | default(primary_keys) | tojson }}
            satellite_attrs = {{ satellite_attrs | default([]) | tojson }}
            transformed = DataModelTransformer.to_data_vault(records, hub_keys, satellite_attrs)

            # Write Hub
            client = storage.Client(project=PROJECT_ID)
            bucket = client.bucket(SILVER_BUCKET)

            hub_path = f"{SOURCE_PATH}/{HUB_TABLE}/{execution_date}/data.json"
            hub_blob = bucket.blob(hub_path)
            hub_blob.upload_from_string(
                '\n'.join(json.dumps(r, default=str) for r in transformed['hubs']),
                content_type='application/json'
            )

            # Write Satellite
            sat_path = f"{SOURCE_PATH}/{SAT_TABLE}/{execution_date}/data.json"
            sat_blob = bucket.blob(sat_path)
            sat_blob.upload_from_string(
                '\n'.join(json.dumps(r, default=str) for r in transformed['satellites']),
                content_type='application/json'
            )

            return {
                'hub_path': f"gs://{SILVER_BUCKET}/{hub_path}",
                'sat_path': f"gs://{SILVER_BUCKET}/{sat_path}",
                'hub_count': len(transformed['hubs']),
                'sat_count': len(transformed['satellites']),
            }
            {%- else %}
            # Write flat/dimensional model
            client = storage.Client(project=PROJECT_ID)
            bucket = client.bucket(SILVER_BUCKET)

            silver_path = f"{SOURCE_PATH}/{execution_date}/data.json"
            blob = bucket.blob(silver_path)
            blob.upload_from_string(
                '\n'.join(json.dumps(r, default=str) for r in records),
                content_type='application/json'
            )

            return {
                'records': records,
                'silver_path': f"gs://{SILVER_BUCKET}/{silver_path}",
                'record_count': len(records),
            }
            {%- endif %}

        silver_result = transform_silver(bronze_result)

    # =========================================================================
    # GOLD + BIGQUERY
    # =========================================================================
    with TaskGroup('gold_zone') as gold_zone:

        @task(task_id='load_to_bigquery')
        def load_to_bigquery(silver_result: Dict, **context) -> Dict:
            """Load data to BigQuery."""
            from google.cloud import bigquery, storage

            bq = bigquery.Client(project=PROJECT_ID)
            execution_date = context['execution_date'].strftime('%Y-%m-%d')

            # Ensure dataset exists
            dataset_ref = bq.dataset(BQ_DATASET)
            try:
                bq.get_dataset(dataset_ref)
            except Exception:
                dataset = bigquery.Dataset(dataset_ref)
                dataset.location = BQ_LOCATION
                bq.create_dataset(dataset, exists_ok=True)

            {%- if destination_model == 'data_vault' %}
            # Load Hub table
            hub_table_id = f"{PROJECT_ID}.{BQ_DATASET}.{HUB_TABLE}"
            hub_job = bq.load_table_from_uri(
                silver_result['hub_path'],
                hub_table_id,
                job_config=bigquery.LoadJobConfig(
                    source_format=bigquery.SourceFormat.NEWLINE_DELIMITED_JSON,
                    autodetect=True,
                    write_disposition=bigquery.WriteDisposition.WRITE_APPEND,
                ),
            )
            hub_job.result()

            # Load Satellite table
            sat_table_id = f"{PROJECT_ID}.{BQ_DATASET}.{SAT_TABLE}"
            sat_job = bq.load_table_from_uri(
                silver_result['sat_path'],
                sat_table_id,
                job_config=bigquery.LoadJobConfig(
                    source_format=bigquery.SourceFormat.NEWLINE_DELIMITED_JSON,
                    autodetect=True,
                    write_disposition=bigquery.WriteDisposition.WRITE_APPEND,
                ),
            )
            sat_job.result()

            return {
                'hub_table': hub_table_id,
                'sat_table': sat_table_id,
                'hub_rows': bq.get_table(hub_table_id).num_rows,
                'sat_rows': bq.get_table(sat_table_id).num_rows,
            }
            {%- else %}
            # Load single table
            table_id = f"{PROJECT_ID}.{BQ_DATASET}.{BQ_TABLE}"

            {%- if extraction_mode == 'cdc' or load_strategy == 'merge' %}
            # For CDC/Merge, use MERGE statement
            staging_table_id = f"{table_id}_staging"

            # Load to staging
            staging_job = bq.load_table_from_uri(
                silver_result.get('silver_path', silver_result.get('records')),
                staging_table_id,
                job_config=bigquery.LoadJobConfig(
                    source_format=bigquery.SourceFormat.NEWLINE_DELIMITED_JSON,
                    autodetect=True,
                    write_disposition=bigquery.WriteDisposition.WRITE_TRUNCATE,
                ),
            )
            staging_job.result()

            # Merge into target
            merge_keys = ' AND '.join(f'T.{k} = S.{k}' for k in PRIMARY_KEYS)
            merge_query = f"""
                MERGE `{table_id}` T
                USING `{staging_table_id}` S
                ON {merge_keys}
                WHEN MATCHED THEN UPDATE SET
                    {', '.join(f'{col} = S.{col}' for col in silver_result.get('records', [{}])[0].keys() if col not in PRIMARY_KEYS)}
                WHEN NOT MATCHED THEN INSERT ROW
            """
            bq.query(merge_query).result()
            bq.delete_table(staging_table_id, not_found_ok=True)
            {%- else %}
            # Simple append/overwrite
            job_config = bigquery.LoadJobConfig(
                source_format=bigquery.SourceFormat.NEWLINE_DELIMITED_JSON,
                autodetect=True,
                write_disposition=bigquery.WriteDisposition.{{ 'WRITE_TRUNCATE' if extraction_mode == 'full' else 'WRITE_APPEND' }},
            )
            load_job = bq.load_table_from_uri(silver_result['silver_path'], table_id, job_config=job_config)
            load_job.result()
            {%- endif %}

            table = bq.get_table(table_id)
            return {
                'table_id': table_id,
                'total_rows': table.num_rows,
            }
            {%- endif %}

        bq_result = load_to_bigquery(silver_result)

    # =========================================================================
    # UPDATE WATERMARK
    # =========================================================================
    @task(task_id='update_watermark')
    def update_watermark(bronze_result: Dict, **context):
        """Update watermark for incremental extraction."""
        if EXTRACTION_MODE != 'incremental':
            return

        new_watermark = bronze_result.get('new_watermark')
        if not new_watermark:
            return

        from airflow.providers.postgres.hooks.postgres import PostgresHook
        hook = PostgresHook(postgres_conn_id=METADATA_DB_CONN_ID)

        hook.run("""
            INSERT INTO pipeline_watermarks (dag_id, environment, last_watermark, updated_at)
            VALUES (%s, %s, %s, NOW())
            ON CONFLICT (dag_id, environment)
            DO UPDATE SET last_watermark = EXCLUDED.last_watermark, updated_at = NOW()
        """, parameters=('{{ dag_id }}', ENVIRONMENT, new_watermark))

        logger.info(f"Updated watermark to: {new_watermark}")

    # =========================================================================
    # NOTIFICATIONS
    # =========================================================================
    {{ success_notification_task() }}
    {{ error_handler_task() }}

    # =========================================================================
    # DEPENDENCIES
    # =========================================================================
    start >> extraction >> bronze_zone >> silver_zone >> gold_zone >> update_watermark(bronze_result) >> send_success_notification() >> end
    [extraction, bronze_zone, silver_zone, gold_zone] >> handle_pipeline_failure()

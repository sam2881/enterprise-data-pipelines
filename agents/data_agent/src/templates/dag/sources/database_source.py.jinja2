class DataModelTransformer:
    """Transform data into different data models."""

    @staticmethod
    def to_dimensional(records: List[Dict], fact_columns: List[str],
                       dimension_columns: List[str]) -> Dict[str, List[Dict]]:
        """Transform to dimensional model (star schema)."""
        facts = []
        dimensions = {}

        for record in records:
            # Extract fact
            fact = {col: record.get(col) for col in fact_columns}
            facts.append(fact)

            # Extract dimensions
            for dim_col in dimension_columns:
                if dim_col not in dimensions:
                    dimensions[dim_col] = {}
                dim_value = record.get(dim_col)
                if dim_value and dim_value not in dimensions[dim_col]:
                    dimensions[dim_col][dim_value] = record

        return {
            'facts': facts,
            'dimensions': {k: list(v.values()) for k, v in dimensions.items()},
        }

    @staticmethod
    def to_data_vault(records: List[Dict], hub_keys: List[str],
                      satellite_attrs: List[str]) -> Dict[str, List[Dict]]:
        """Transform to Data Vault model (Hub + Satellite)."""
        import hashlib
        from datetime import datetime as dt

        hubs = []
        satellites = []
        load_date = dt.utcnow().isoformat()

        for record in records:
            # Create hub hash key
            hub_key_values = '|'.join(str(record.get(k, '')) for k in hub_keys)
            hash_key = hashlib.md5(hub_key_values.encode()).hexdigest()

            # Hub record
            hub = {
                'hash_key': hash_key,
                'load_date': load_date,
                'record_source': '{{ source_table }}',
            }
            for k in hub_keys:
                hub[k] = record.get(k)
            hubs.append(hub)

            # Satellite record
            sat_values = '|'.join(str(record.get(k, '')) for k in satellite_attrs)
            hash_diff = hashlib.md5(sat_values.encode()).hexdigest()

            satellite = {
                'hash_key': hash_key,
                'hash_diff': hash_diff,
                'load_date': load_date,
                'load_end_date': None,
                'record_source': '{{ source_table }}',
            }
            for k in satellite_attrs:
                satellite[k] = record.get(k)
            satellites.append(satellite)

        return {'hubs': hubs, 'satellites': satellites}



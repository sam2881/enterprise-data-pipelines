class DatabaseExtractor:
    """Universal database extractor supporting all enterprise databases."""

    @staticmethod
    def get_connection(db_type: str, conn_id: str):
        """Get database connection based on type."""
        if db_type == 'oracle':
            from airflow.providers.oracle.hooks.oracle import OracleHook
            return OracleHook(oracle_conn_id=conn_id).get_conn()
        elif db_type == 'sqlserver':
            from airflow.providers.microsoft.mssql.hooks.mssql import MsSqlHook
            return MsSqlHook(mssql_conn_id=conn_id).get_conn()
        elif db_type == 'postgres':
            from airflow.providers.postgres.hooks.postgres import PostgresHook
            return PostgresHook(postgres_conn_id=conn_id).get_conn()
        elif db_type == 'mysql':
            from airflow.providers.mysql.hooks.mysql import MySqlHook
            return MySqlHook(mysql_conn_id=conn_id).get_conn()
        elif db_type == 'db2':
            # DB2 requires ibm_db
            from airflow.hooks.base import BaseHook
            conn = BaseHook.get_connection(conn_id)
            import ibm_db_dbi
            return ibm_db_dbi.connect(
                f"DATABASE={conn.schema};HOSTNAME={conn.host};PORT={conn.port};"
                f"PROTOCOL=TCPIP;UID={conn.login};PWD={conn.password};"
            )
        elif db_type == 'snowflake':
            from airflow.providers.snowflake.hooks.snowflake import SnowflakeHook
            return SnowflakeHook(snowflake_conn_id=conn_id).get_conn()
        else:
            raise ValueError(f"Unsupported database type: {db_type}")

    @staticmethod
    def extract_full(conn, query: str) -> List[Dict]:
        """Full table extraction."""
        cursor = conn.cursor()
        cursor.execute(query)

        columns = [desc[0].lower() for desc in cursor.description]
        records = [dict(zip(columns, row)) for row in cursor.fetchall()]

        cursor.close()
        return records

    @staticmethod
    def extract_incremental(conn, query: str, watermark_column: str,
                           last_watermark: Any, watermark_type: str) -> List[Dict]:
        """Incremental extraction using watermark."""
        if watermark_type == 'timestamp':
            incremental_query = f"""
                {query}
                WHERE {watermark_column} > TO_TIMESTAMP('{last_watermark}', 'YYYY-MM-DD HH24:MI:SS')
                ORDER BY {watermark_column}
            """
        else:
            incremental_query = f"""
                {query}
                WHERE {watermark_column} > {last_watermark}
                ORDER BY {watermark_column}
            """

        cursor = conn.cursor()
        cursor.execute(incremental_query)

        columns = [desc[0].lower() for desc in cursor.description]
        records = [dict(zip(columns, row)) for row in cursor.fetchall()]

        cursor.close()
        return records


class CDCProcessor:
    """Process CDC events from Debezium."""

    @staticmethod
    def consume_cdc_events(bootstrap_servers: str, topic: str,
                           consumer_group: str, max_messages: int = 10000) -> List[Dict]:
        """Consume CDC events from Kafka."""
        from kafka import KafkaConsumer

        consumer = KafkaConsumer(
            topic,
            bootstrap_servers=bootstrap_servers,
            group_id=consumer_group,
            auto_offset_reset='earliest',
            enable_auto_commit=False,
            value_deserializer=lambda m: json.loads(m.decode('utf-8')),
            max_poll_records=max_messages,
        )

        events = []
        for msg in consumer:
            event = CDCProcessor.parse_debezium_event(msg.value)
            if event:
                events.append(event)
            if len(events) >= max_messages:
                break

        consumer.commit()
        consumer.close()
        return events

    @staticmethod
    def parse_debezium_event(event: Dict) -> Optional[Dict]:
        """Parse Debezium CDC event."""
        payload = event.get('payload', event)

        op_map = {'c': 'INSERT', 'u': 'UPDATE', 'd': 'DELETE', 'r': 'READ'}
        operation = op_map.get(payload.get('op', 'r'), 'UNKNOWN')

        if operation not in CDC_OPERATIONS:
            return None

        return {
            'operation': operation,
            'before': payload.get('before'),
            'after': payload.get('after'),
            'timestamp': payload.get('ts_ms'),
            'source': payload.get('source', {}),
        }

    @staticmethod
    def apply_cdc_to_target(current_data: List[Dict], cdc_events: List[Dict],
                            primary_keys: List[str]) -> List[Dict]:
        """Apply CDC changes to current dataset."""
        # Build lookup by primary key
        pk_lookup = {}
        for record in current_data:
            pk = tuple(record.get(k) for k in primary_keys)
            pk_lookup[pk] = record

        # Apply changes in order
        for event in sorted(cdc_events, key=lambda x: x.get('timestamp', 0)):
            after = event.get('after') or {}
            before = event.get('before') or {}

            pk_after = tuple(after.get(k) for k in primary_keys) if after else None
            pk_before = tuple(before.get(k) for k in primary_keys) if before else None

            if event['operation'] == 'INSERT':
                pk_lookup[pk_after] = after
            elif event['operation'] == 'UPDATE':
                pk_lookup[pk_after] = after
            elif event['operation'] == 'DELETE':
                pk_lookup.pop(pk_before, None)

        return list(pk_lookup.values())



class SSISParser:
    """Parse SSIS DTSX package components."""

    @staticmethod
    def parse_dtsx_from_gcs(gcs_path: str) -> Dict:
        """
        Parse DTSX file from GCS and extract all components.

        Returns dict with: sources, transformations, destinations, variables, connections
        """
        from google.cloud import storage
        import xml.etree.ElementTree as ET

        # Download DTSX from GCS
        client = storage.Client(project=PROJECT_ID)
        bucket_name = gcs_path.replace('gs://', '').split('/')[0]
        blob_path = '/'.join(gcs_path.replace('gs://', '').split('/')[1:])

        bucket = client.bucket(bucket_name)
        blob = bucket.blob(blob_path)
        content = blob.download_as_string()

        # Parse XML
        root = ET.fromstring(content)

        # SSIS namespaces
        ns = {
            'DTS': 'www.microsoft.com/SqlServer/Dts',
            'SQLTask': 'www.microsoft.com/sqlserver/dts/tasks/sqltask',
        }

        result = {
            'sources': [],
            'transformations': [],
            'destinations': [],
            'variables': {},
            'connections': {},
            'sql_tasks': [],
            'precedence_constraints': [],
        }

        # Parse Connection Managers
        for conn in root.findall('.//DTS:ConnectionManager', ns):
            conn_name = conn.get('{www.microsoft.com/SqlServer/Dts}ObjectName')
            conn_string = conn.find('.//DTS:Property[@DTS:Name="ConnectionString"]', ns)
            if conn_string is not None:
                result['connections'][conn_name] = SSISParser._parse_connection_string(conn_string.text)

        # Parse Variables
        for var in root.findall('.//DTS:Variable', ns):
            var_name = var.get('{www.microsoft.com/SqlServer/Dts}ObjectName')
            var_value = var.find('.//DTS:Property[@DTS:Name="Expression"]', ns)
            if var_value is not None:
                result['variables'][var_name] = var_value.text

        # Parse Data Flow Tasks
        for dft in root.findall('.//DTS:Executable[@DTS:ExecutableType="SSIS.Pipeline"]', ns):
            components = dft.findall('.//component', ns)
            for comp in components:
                comp_type = comp.get('componentClassID', '')

                if 'Source' in comp_type:
                    result['sources'].append(SSISParser._parse_source_component(comp))
                elif 'Destination' in comp_type:
                    result['destinations'].append(SSISParser._parse_destination_component(comp))
                else:
                    result['transformations'].append(SSISParser._parse_transform_component(comp))

        # Parse SQL Tasks
        for sql_task in root.findall('.//DTS:Executable[@DTS:ExecutableType="Microsoft.SqlServer.Dts.Tasks.ExecuteSQLTask.ExecuteSQLTask"]', ns):
            result['sql_tasks'].append(SSISParser._parse_sql_task(sql_task, ns))

        return result

    @staticmethod
    def _parse_connection_string(conn_str: str) -> Dict:
        """Parse SSIS connection string into components."""
        result = {'raw': conn_str}

        # Parse key=value pairs
        for part in conn_str.split(';'):
            if '=' in part:
                key, value = part.split('=', 1)
                result[key.strip().lower()] = value.strip()

        return result

    @staticmethod
    def _parse_source_component(comp) -> Dict:
        """Parse SSIS source component."""
        comp_name = comp.get('name', 'Unknown')
        comp_type = comp.get('componentClassID', '')

        source = {
            'name': comp_name,
            'type': 'OLE_DB' if 'OLEDBSource' in comp_type else 'FLAT_FILE' if 'FlatFile' in comp_type else 'UNKNOWN',
            'columns': [],
        }

        # Extract SQL command
        for prop in comp.findall('.//property'):
            if prop.get('name') == 'SqlCommand':
                source['query'] = prop.text
            elif prop.get('name') == 'OpenRowset':
                source['table'] = prop.text

        # Extract output columns
        for col in comp.findall('.//outputColumn'):
            source['columns'].append({
                'name': col.get('name'),
                'dataType': col.get('dataType'),
                'length': col.get('length'),
            })

        return source

    @staticmethod
    def _parse_destination_component(comp) -> Dict:
        """Parse SSIS destination component."""
        return {
            'name': comp.get('name', 'Unknown'),
            'type': 'OLE_DB_DEST',
            'table': comp.find('.//property[@name="OpenRowset"]').text if comp.find('.//property[@name="OpenRowset"]') else None,
        }

    @staticmethod
    def _parse_transform_component(comp) -> Dict:
        """Parse SSIS transformation component."""
        comp_type = comp.get('componentClassID', '')

        transform = {
            'name': comp.get('name', 'Unknown'),
            'type': 'UNKNOWN',
        }

        if 'DerivedColumn' in comp_type:
            transform['type'] = 'DERIVED_COLUMN'
            transform['columns'] = []
            for col in comp.findall('.//outputColumn'):
                expr = col.find('.//property[@name="Expression"]')
                transform['columns'].append({
                    'name': col.get('name'),
                    'expression': expr.text if expr is not None else None,
                })
        elif 'Lookup' in comp_type:
            transform['type'] = 'LOOKUP'
        elif 'ConditionalSplit' in comp_type:
            transform['type'] = 'CONDITIONAL_SPLIT'
        elif 'Sort' in comp_type:
            transform['type'] = 'SORT'
        elif 'Aggregate' in comp_type:
            transform['type'] = 'AGGREGATE'
        elif 'MergeJoin' in comp_type:
            transform['type'] = 'MERGE_JOIN'

        return transform

    @staticmethod
    def _parse_sql_task(sql_task, ns) -> Dict:
        """Parse SSIS Execute SQL Task."""
        task_name = sql_task.get('{www.microsoft.com/SqlServer/Dts}ObjectName', 'Unknown')
        sql_statement = None

        for prop in sql_task.findall('.//DTS:Property', ns):
            if prop.get('{www.microsoft.com/SqlServer/Dts}Name') == 'SqlStatementSource':
                sql_statement = prop.text

        return {
            'name': task_name,
            'sql': sql_statement,
        }


class SSISTransformConverter:
    """Convert SSIS transformations to PySpark/SQL."""

    @staticmethod
    def convert_derived_column(ssis_expr: str) -> str:
        """Convert SSIS derived column expression to PySpark."""
        # Common SSIS to PySpark mappings
        mappings = {
            r'\+': ' + ',  # String concatenation in SSIS is +
            r'ISNULL\(([^,]+),([^)]+)\)': r'F.coalesce(F.col("\1"), \2)',
            r'TRIM\(([^)]+)\)': r'F.trim(F.col("\1"))',
            r'UPPER\(([^)]+)\)': r'F.upper(F.col("\1"))',
            r'LOWER\(([^)]+)\)': r'F.lower(F.col("\1"))',
            r'LEN\(([^)]+)\)': r'F.length(F.col("\1"))',
            r'SUBSTRING\(([^,]+),(\d+),(\d+)\)': r'F.substring(F.col("\1"), \2, \3)',
            r'GETDATE\(\)': 'F.current_timestamp()',
            r'YEAR\(([^)]+)\)': r'F.year(F.col("\1"))',
            r'MONTH\(([^)]+)\)': r'F.month(F.col("\1"))',
            r'DAY\(([^)]+)\)': r'F.dayofmonth(F.col("\1"))',
            r'CONVERT\(DT_STR,([^,]+),\d+\)': r'F.col("\1").cast("string")',
            r'CONVERT\(DT_I4,([^)]+)\)': r'F.col("\1").cast("integer")',
            r'CONVERT\(DT_NUMERIC,([^,]+),[^)]+\)': r'F.col("\1").cast("decimal")',
        }

        result = ssis_expr
        for pattern, replacement in mappings.items():
            result = re.sub(pattern, replacement, result, flags=re.IGNORECASE)

        return result

    @staticmethod
    def generate_pyspark_transform(transformations: List[Dict]) -> str:
        """Generate PySpark transformation code from SSIS transformations."""
        code_lines = []

        for transform in transformations:
            if transform['type'] == 'DERIVED_COLUMN':
                for col in transform.get('columns', []):
                    expr = SSISTransformConverter.convert_derived_column(col.get('expression', ''))
                    code_lines.append(f"df = df.withColumn(\"{col['name']}\", {expr})")

            elif transform['type'] == 'LOOKUP':
                code_lines.append("# LOOKUP: Implement as join with lookup table")
                code_lines.append("# lookup_df = spark.read.table('lookup_table')")
                code_lines.append("# df = df.join(lookup_df, on='key_column', how='left')")

            elif transform['type'] == 'CONDITIONAL_SPLIT':
                code_lines.append("# CONDITIONAL_SPLIT: Implement as filter")
                code_lines.append("# df_condition1 = df.filter('condition1')")
                code_lines.append("# df_condition2 = df.filter('condition2')")

            elif transform['type'] == 'SORT':
                code_lines.append("df = df.orderBy('sort_column')")

            elif transform['type'] == 'AGGREGATE':
                code_lines.append("# AGGREGATE: Implement groupBy")
                code_lines.append("# df = df.groupBy('group_column').agg(F.sum('value_column'))")

        return '\n    '.join(code_lines) if code_lines else '# No transformations to apply'



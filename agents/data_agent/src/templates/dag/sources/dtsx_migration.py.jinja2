default_args = {
    'owner': '{{ owner | default("data-platform") }}',
    'depends_on_past': False,
    'email': ALERT_EMAILS,
    'email_on_failure': True,
    'retries': {{ retries | default(2) }},
    'retry_delay': timedelta(minutes={{ retry_delay_minutes | default(5) }}),
}

with DAG(
    dag_id='{{ dag_id }}',
    default_args=default_args,
    description='SSIS Migration: {{ dtsx_package_name }} -> Modern Pipeline',
    schedule_interval='{{ schedule_interval | default("@daily") }}',
    start_date=datetime({{ start_year | default(2024) }}, {{ start_month | default(1) }}, {{ start_day | default(1) }}),
    catchup={{ catchup | default(False) }},
    max_active_runs={{ max_active_runs | default(1) }},
    tags={{ tags | default(['ssis-migration', 'dtsx', domain_name]) | tojson }},
    doc_md="""
    ## SSIS Migration Pipeline

    **Original Package:** {{ dtsx_package_name }}
    **Original Server:** {{ original_server | default('Unknown') }}
    **Migration Date:** {{ migration_date | default('Auto-generated') }}

    ### Source Mappings
    {% for source in parsed_sources %}
    - {{ source.name }}: {{ source.type }} -> {{ source.table | default(source.query[:50] if source.query else 'N/A') }}
    {% endfor %}

    ### Transformation Chain
    {% for transform in parsed_transformations %}
    - {{ transform.name }}: {{ transform.type }}
    {% endfor %}
    """,
) as dag:

    start = EmptyOperator(task_id='start')
    end = EmptyOperator(task_id='end', trigger_rule=TriggerRule.ALL_DONE)

    # =========================================================================
    # PARSE DTSX (if not pre-parsed)
    # =========================================================================
    @task(task_id='parse_dtsx_package')
    def parse_dtsx_package(**context) -> Dict:
        """Parse DTSX package to extract components (if not pre-parsed)."""
        if SSIS_SOURCES and SSIS_DESTINATIONS:
            logger.info("Using pre-parsed SSIS components")
            return {
                'sources': SSIS_SOURCES,
                'transformations': SSIS_TRANSFORMATIONS,
                'destinations': SSIS_DESTINATIONS,
                'connections': SSIS_CONNECTIONS,
                'variables': SSIS_VARIABLES,
            }

        logger.info(f"Parsing DTSX from: {DTSX_LOCATION}")
        parsed = SSISParser.parse_dtsx_from_gcs(DTSX_LOCATION)
        logger.info(f"Parsed: {len(parsed['sources'])} sources, {len(parsed['transformations'])} transforms")

        return parsed

    parsed_result = parse_dtsx_package()

    # =========================================================================
    # EXTRACT FROM SOURCES
    # =========================================================================
    with TaskGroup('extract_sources') as extract_sources:

        @task(task_id='extract_from_legacy')
        def extract_from_legacy(parsed_result: Dict, **context) -> Dict:
            """Extract data from legacy sources defined in SSIS package."""
            all_records = []

            for source in parsed_result['sources']:
                source_type = source.get('type', 'UNKNOWN')
                logger.info(f"Extracting from {source['name']} ({source_type})")

                if source_type == 'OLE_DB':
                    # Get connection details
                    conn_name = source.get('connection')
                    airflow_conn = CONNECTION_MAPPING.get(conn_name, 'mssql_default')

                    # Extract using Airflow hook
                    from airflow.providers.microsoft.mssql.hooks.mssql import MsSqlHook
                    hook = MsSqlHook(mssql_conn_id=airflow_conn)

                    query = source.get('query') or f"SELECT * FROM {source.get('table')}"
                    records = hook.get_records(query)

                    # Get column names
                    columns = [col['name'] for col in source.get('columns', [])]
                    if not columns:
                        columns = [f'col_{i}' for i in range(len(records[0]))] if records else []

                    source_records = [dict(zip(columns, row)) for row in records]
                    all_records.extend(source_records)
                    logger.info(f"Extracted {len(source_records)} records from {source['name']}")

                elif source_type == 'FLAT_FILE':
                    # Read flat file from GCS
                    from google.cloud import storage
                    client = storage.Client(project=PROJECT_ID)

                    file_path = source.get('file_path', f"gs://{RAW_BUCKET}/{SOURCE_PATH}/data.csv")
                    # Parse based on format
                    # ... file parsing logic

            return {
                'records': all_records,
                'source_count': len(parsed_result['sources']),
                'total_records': len(all_records),
            }

        extract_result = extract_from_legacy(parsed_result)

    # =========================================================================
    # APPLY TRANSFORMATIONS (Converted from SSIS)
    # =========================================================================
    with TaskGroup('apply_transformations') as apply_transformations:

        @task(task_id='transform_data')
        def transform_data(extract_result: Dict, parsed_result: Dict, **context) -> Dict:
            """Apply SSIS transformations converted to Python/PySpark."""
            records = extract_result['records']

            if not records:
                return {'records': [], 'transformed': False}

            transformations = parsed_result.get('transformations', [])
            logger.info(f"Applying {len(transformations)} transformations")

            # Apply each transformation
            for transform in transformations:
                transform_type = transform.get('type')

                if transform_type == 'DERIVED_COLUMN':
                    for col_def in transform.get('columns', []):
                        col_name = col_def['name']
                        expr = col_def.get('expression', '')

                        # Simple expression evaluation
                        for record in records:
                            try:
                                # Handle common SSIS expressions
                                if '+' in expr:
                                    # String concatenation
                                    parts = [p.strip() for p in expr.split('+')]
                                    result = ''
                                    for part in parts:
                                        if part.startswith('"') and part.endswith('"'):
                                            result += part.strip('"')
                                        elif part in record:
                                            result += str(record.get(part, ''))
                                    record[col_name] = result
                                else:
                                    record[col_name] = record.get(expr.strip(), '')
                            except Exception as e:
                                logger.warning(f"Transform error on {col_name}: {e}")
                                record[col_name] = None

                elif transform_type == 'LOOKUP':
                    # Lookup implementation would go here
                    pass

            return {
                'records': records,
                'transformed': True,
                'transformation_count': len(transformations),
            }

        transform_result = transform_data(extract_result, parsed_result)

    # =========================================================================
    # WRITE TO MEDALLION LAYERS
    # =========================================================================
    with TaskGroup('write_medallion') as write_medallion:

        @task(task_id='write_to_layers')
        def write_to_layers(transform_result: Dict, **context) -> Dict:
            """Write to Bronze, Silver, Gold layers."""
            from google.cloud import storage

            records = transform_result['records']
            if not records:
                return {'status': 'skipped'}

            execution_date = context['execution_date'].strftime('%Y-%m-%d')
            client = storage.Client(project=PROJECT_ID)

            # Add audit columns
            for record in records:
                record['_migrated_from'] = DTSX_PACKAGE_NAME
                record['_migration_timestamp'] = datetime.utcnow().isoformat()
                record['_execution_date'] = execution_date

            ndjson = '\n'.join(json.dumps(r, default=str) for r in records)

            # Write Bronze
            bronze_path = f"{SOURCE_PATH}/{execution_date}/data.json"
            bronze_bucket = client.bucket(BRONZE_BUCKET)
            bronze_bucket.blob(bronze_path).upload_from_string(ndjson)

            # Write Silver (deduplicated)
            seen = {}
            for record in records:
                pk = tuple(record.get(k) for k in PRIMARY_KEYS)
                seen[pk] = record
            deduped = list(seen.values())

            silver_bucket = client.bucket(SILVER_BUCKET)
            silver_bucket.blob(bronze_path).upload_from_string(
                '\n'.join(json.dumps(r, default=str) for r in deduped)
            )

            # Write Gold
            gold_bucket = client.bucket(GOLD_BUCKET)
            gold_bucket.blob(bronze_path).upload_from_string(
                '\n'.join(json.dumps(r, default=str) for r in deduped)
            )

            return {
                'bronze_path': f"gs://{BRONZE_BUCKET}/{bronze_path}",
                'silver_path': f"gs://{SILVER_BUCKET}/{bronze_path}",
                'gold_path': f"gs://{GOLD_BUCKET}/{bronze_path}",
                'record_count': len(deduped),
            }

        layer_result = write_to_layers(transform_result)

    # =========================================================================
    # LOAD TO BIGQUERY
    # =========================================================================
    with TaskGroup('load_bigquery') as load_bigquery:

        @task(task_id='load_to_bq')
        def load_to_bq(layer_result: Dict, **context) -> Dict:
            """Load to BigQuery."""
            from google.cloud import bigquery

            if layer_result.get('status') == 'skipped':
                return {'status': 'skipped'}

            bq = bigquery.Client(project=PROJECT_ID)

            # Ensure dataset
            dataset_ref = bq.dataset(BQ_DATASET)
            try:
                bq.get_dataset(dataset_ref)
            except Exception:
                dataset = bigquery.Dataset(dataset_ref)
                dataset.location = BQ_LOCATION
                bq.create_dataset(dataset, exists_ok=True)

            table_id = f"{PROJECT_ID}.{BQ_DATASET}.{BQ_TABLE}"

            job_config = bigquery.LoadJobConfig(
                source_format=bigquery.SourceFormat.NEWLINE_DELIMITED_JSON,
                autodetect=True,
                write_disposition=bigquery.WriteDisposition.WRITE_APPEND,
            )

            load_job = bq.load_table_from_uri(
                layer_result['gold_path'],
                table_id,
                job_config=job_config,
            )
            load_job.result()

            table = bq.get_table(table_id)

            return {
                'table_id': table_id,
                'total_rows': table.num_rows,
            }

        bq_result = load_to_bq(layer_result)

    # =========================================================================
    # LOG MIGRATION METADATA
    # =========================================================================
    @task(task_id='log_migration')
    def log_migration(bq_result: Dict, **context):
        """Log migration metadata to PostgreSQL."""
        _log_pipeline_event('SSIS_MIGRATION_COMPLETE', {
            'dtsx_package': DTSX_PACKAGE_NAME,
            'original_server': ORIGINAL_SERVER,
            'execution_date': context['execution_date'].isoformat(),
            'bigquery_table': bq_result.get('table_id'),
            'rows_loaded': bq_result.get('total_rows'),
        })

    # =========================================================================
    # NOTIFICATIONS
    # =========================================================================
    {{ success_notification_task() }}
    {{ error_handler_task() }}

    # =========================================================================
    # DEPENDENCIES
    # =========================================================================
    start >> parsed_result >> extract_sources >> apply_transformations >> write_medallion >> load_bigquery >> log_migration(bq_result) >> send_success_notification() >> end
    [extract_sources, apply_transformations, write_medallion, load_bigquery] >> handle_pipeline_failure()

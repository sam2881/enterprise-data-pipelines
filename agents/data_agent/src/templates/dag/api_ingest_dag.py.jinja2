{#
API Ingest DAG Template

WHY: Generates Airflow DAG for REST API data ingestion.
     Handles API polling, pagination, and incremental loading.

TEMPLATE VARIABLES:
- dag_id: Unique DAG identifier
- pipeline_name: Name of the pipeline
- domain: Data domain
- schedule: Cron schedule
- api_endpoint: REST API endpoint URL
- api_method: HTTP method (GET, POST)
- bronze_table: Bronze layer table name
- silver_table: Silver layer table name
- spark_job_paths: Dict of layer -> GCS path to spark jobs
#}
"""
{{ dag_id }} - API Ingest Pipeline

Pipeline: {{ pipeline_name }}
Domain: {{ domain }}
API Endpoint: {{ api_endpoint }}
Method: {{ api_method | default('GET') }}
Schedule: {{ schedule }}

FLOW:
1. Check API health/availability
2. Extract data from API (with pagination)
3. Write raw data to GCS landing zone
4. Run bronze ingest Spark job
5. Run silver transform
6. Load to BigQuery gold layer

Generated by Data Agent
Jira: {{ jira_ticket | default('N/A') }}
"""

from datetime import datetime, timedelta
import json
from airflow import DAG
from airflow.operators.empty import EmptyOperator
from airflow.operators.python import PythonOperator
from airflow.providers.http.sensors.http import HttpSensor
from airflow.providers.http.operators.http import SimpleHttpOperator
from airflow.providers.google.cloud.operators.dataproc import DataprocSubmitJobOperator
from airflow.providers.google.cloud.transfers.local_to_gcs import LocalFilesystemToGCSOperator
from airflow.utils.task_group import TaskGroup


# Configuration
PROJECT_ID = "{{ '{{ var.value.gcp_project_id }}' }}"
REGION = "{{ '{{ var.value.gcp_region }}' }}"
CLUSTER_NAME = "{{ '{{ var.value.dataproc_cluster }}' }}"

# API Configuration
API_ENDPOINT = "{{ api_endpoint }}"
API_METHOD = "{{ api_method | default('GET') }}"
API_CONN_ID = "{{ api_conn_id | default('http_default') }}"

# Paths
LANDING_PATH = "{{ landing_path | default('gs://landing/') }}{{ domain }}/{{ pipeline_name }}"

# Spark job URIs
BRONZE_JOB_URI = "{{ spark_job_paths.bronze | default('gs://spark-jobs/bronze.py') }}"
SILVER_JOB_URI = "{{ spark_job_paths.silver | default('gs://spark-jobs/silver.py') }}"
GOLD_JOB_URI = "{{ spark_job_paths.gold | default('gs://spark-jobs/gold_load_bq.py') }}"

default_args = {
    "owner": "{{ owner | default('data-platform') }}",
    "depends_on_past": {{ depends_on_past | default(False) }},
    "email_on_failure": {{ email_on_failure | default(True) }},
    "email_on_retry": False,
    "retries": {{ retries | default(3) }},
    "retry_delay": timedelta(minutes={{ retry_delay_minutes | default(5) }}),
    "execution_timeout": timedelta(hours={{ execution_timeout_hours | default(2) }}),
}


def _build_pyspark_job(main_python_file_uri: str, args: list = None) -> dict:
    """Build Dataproc PySpark job configuration."""
    return {
        "placement": {"cluster_name": CLUSTER_NAME},
        "pyspark_job": {
            "main_python_file_uri": main_python_file_uri,
            "args": args or [],
            "properties": {
                "spark.sql.adaptive.enabled": "true",
                "spark.sql.adaptive.coalescePartitions.enabled": "true",
            },
        },
    }


def _extract_and_upload_api_data(**context):
    """
    Extract data from API and upload to GCS.

    Handles pagination if response contains 'next' link.
    """
    import requests
    from google.cloud import storage

    execution_date = context["ds"]
    all_data = []
    page = 1
    max_pages = {{ max_pages | default(100) }}

    # Extract from API
    url = API_ENDPOINT
    while url and page <= max_pages:
        response = requests.request(
            method=API_METHOD,
            url=url,
            headers={"Content-Type": "application/json"},
            timeout=60,
        )
        response.raise_for_status()
        data = response.json()

        # Handle different response structures
        if isinstance(data, list):
            all_data.extend(data)
            break
        elif isinstance(data, dict):
            if "data" in data:
                all_data.extend(data["data"])
            elif "results" in data:
                all_data.extend(data["results"])
            else:
                all_data.append(data)

            # Check for pagination
            url = data.get("next") or data.get("nextLink")
            page += 1

    # Upload to GCS
    if all_data:
        # Parse bucket and path from LANDING_PATH
        bucket_name = LANDING_PATH.replace("gs://", "").split("/")[0]
        blob_path = "/".join(LANDING_PATH.replace("gs://", "").split("/")[1:])
        blob_path = f"{blob_path}/{execution_date}/data.json"

        client = storage.Client()
        bucket = client.bucket(bucket_name)
        blob = bucket.blob(blob_path)
        blob.upload_from_string(
            json.dumps(all_data, indent=2),
            content_type="application/json",
        )

        return {"records": len(all_data), "path": f"gs://{bucket_name}/{blob_path}"}

    return {"records": 0, "path": None}


with DAG(
    dag_id="{{ dag_id }}",
    default_args=default_args,
    description="API ingest pipeline for {{ pipeline_name }} - {{ domain }}",
    schedule="{{ schedule }}",
    start_date=datetime.strptime("{{ start_date | default('2024-01-01') }}", "%Y-%m-%d"),
    catchup={{ catchup | default(False) }},
    max_active_runs={{ max_active_runs | default(1) }},
    tags={{ tags | default(['data-platform', 'api-ingest', domain]) | tojson }},
    doc_md=__doc__,
) as dag:

    start = EmptyOperator(task_id="start")

    # Check API health
    check_api = HttpSensor(
        task_id="check_api_health",
        http_conn_id=API_CONN_ID,
        endpoint="{{ api_health_endpoint | default('/health') }}",
        response_check=lambda response: response.status_code == 200,
        poke_interval=30,
        timeout=300,
    )

    # Extract data from API
    extract_data = PythonOperator(
        task_id="extract_api_data",
        python_callable=_extract_and_upload_api_data,
    )

    # Bronze Layer - Raw Data Ingestion
    with TaskGroup(group_id="bronze_layer") as bronze_layer:
        bronze_ingest = DataprocSubmitJobOperator(
            task_id="bronze_ingest",
            project_id=PROJECT_ID,
            region=REGION,
            job=_build_pyspark_job(
                BRONZE_JOB_URI,
                args=[
                    "--source-path", LANDING_PATH,
                    "--target-table", "{{ bronze_table }}",
                    "--file-format", "json",
                    "--execution-date", "{{ '{{ ds }}' }}",
                ],
            ),
        )

    # Silver Layer - Cleansing and Transformation
    with TaskGroup(group_id="silver_layer") as silver_layer:
        silver_transform = DataprocSubmitJobOperator(
            task_id="silver_transform",
            project_id=PROJECT_ID,
            region=REGION,
            job=_build_pyspark_job(
                SILVER_JOB_URI,
                args=[
                    "--source-table", "{{ bronze_table }}",
                    "--target-table", "{{ silver_table }}",
                    "--execution-date", "{{ '{{ ds }}' }}",
                ],
            ),
        )

    # Gold Layer - Load to BigQuery
    with TaskGroup(group_id="gold_layer") as gold_layer:
        gold_load_bq = DataprocSubmitJobOperator(
            task_id="gold_load_bq",
            project_id=PROJECT_ID,
            region=REGION,
            job=_build_pyspark_job(
                GOLD_JOB_URI,
                args=[
                    "--source-table", "{{ silver_table }}",
                    "--bq-dataset", "{{ bigquery_dataset | default(domain) }}",
                    "--bq-table", "{{ bigquery_table | default(pipeline_name) }}",
                    "--execution-date", "{{ '{{ ds }}' }}",
                ],
            ),
        )

    end = EmptyOperator(task_id="end")

    # Define task dependencies
    start >> check_api >> extract_data >> bronze_layer >> silver_layer >> gold_layer >> end

logger = logging.getLogger("{{ pipeline_name }}_bronze")


# Schema definition from metadata
def get_schema() -> StructType:
    """
    Returns the schema for {{ pipeline_name }}.

    Generated from intent JSON schema definition.
    """
    return StructType([
        {%- for column in columns %}
        StructField(
            "{{ column.name }}",
            {{ column.data_type | default('StringType', true) }}(),
            {{ column.nullable | default(true) | lower }}
        ),
        {%- endfor %}
    ])


def get_type_mapping() -> dict:
    """Map string type names to PySpark types."""
    return {
        "string": StringType(),
        "integer": IntegerType(),
        "int": IntegerType(),
        "long": LongType(),
        "bigint": LongType(),
        "double": DoubleType(),
        "float": DoubleType(),
        "boolean": BooleanType(),
        "bool": BooleanType(),
        "timestamp": TimestampType(),
        "date": DateType(),
        "decimal": DecimalType(38, 10),
    }


def read_source_data(
    spark: SparkSession,
    source_path: str,
    file_format: str,
    schema: Optional[StructType] = None,
) -> DataFrame:
    """
    Read data from source path.

    Args:
        spark: SparkSession
        source_path: Path to source data (GCS, S3, local)
        file_format: Format of source files (parquet, csv, json, avro)
        schema: Optional schema to apply

    Returns:
        DataFrame with source data
    """
    logger.info(f"Reading {file_format} data from {source_path}")

    reader = spark.read

    if schema:
        reader = reader.schema(schema)

    if file_format == "parquet":
        df = reader.parquet(source_path)
    elif file_format == "csv":
        df = reader.option("header", "true") \
                   .option("inferSchema", "false" if schema else "true") \
                   .option("mode", "PERMISSIVE") \
                   .option("columnNameOfCorruptRecord", "_corrupt_record") \
                   .csv(source_path)
    elif file_format == "json":
        df = reader.option("mode", "PERMISSIVE") \
                   .option("columnNameOfCorruptRecord", "_corrupt_record") \
                   .json(source_path)
    elif file_format == "avro":
        df = reader.format("avro").load(source_path)
    elif file_format == "orc":
        df = reader.orc(source_path)
    else:
        raise ValueError(f"Unsupported file format: {file_format}")

    record_count = df.count()
    logger.info(f"Read {record_count} records from source")

    return df


def add_audit_columns(
    df: DataFrame,
    batch_id: str,
    source_path: str,
) -> DataFrame:
    """
    Add audit columns to DataFrame.

    Columns added:
    - _ingested_at: Timestamp of ingestion
    - _source_file: Source file path
    - _batch_id: Unique batch identifier
    - _row_hash: Hash of all columns for change detection

    Args:
        df: Source DataFrame
        batch_id: Unique batch identifier
        source_path: Source file path

    Returns:
        DataFrame with audit columns
    """
    logger.info("Adding audit columns")

    # Get all columns for hash computation
    data_columns = [F.col(c).cast("string") for c in df.columns]

    return df.withColumn("_ingested_at", F.current_timestamp()) \
             .withColumn("_source_file", F.lit(source_path)) \
             .withColumn("_batch_id", F.lit(batch_id)) \
             .withColumn("_row_hash", F.sha2(F.concat_ws("|", *data_columns), 256))


def validate_data(df: DataFrame) -> tuple[DataFrame, DataFrame]:
    """
    Validate data and separate valid from invalid records.

    Returns:
        Tuple of (valid_df, invalid_df)
    """
    logger.info("Validating data quality")

    # Check for corrupt records if column exists
    if "_corrupt_record" in df.columns:
        valid_df = df.filter(F.col("_corrupt_record").isNull()) \
                     .drop("_corrupt_record")
        invalid_df = df.filter(F.col("_corrupt_record").isNotNull())

        invalid_count = invalid_df.count()
        if invalid_count > 0:
            logger.warning(f"Found {invalid_count} corrupt records")
    else:
        valid_df = df
        invalid_df = spark.createDataFrame([], df.schema)

    return valid_df, invalid_df


def write_to_bronze(
    df: DataFrame,
    table_name: str,
    partition_columns: list[str],
    mode: str = "append",
) -> None:
    """
    Write DataFrame to bronze Delta table.

    Args:
        df: DataFrame to write
        table_name: Target Delta table name
        partition_columns: Columns to partition by
        mode: Write mode (append, overwrite)
    """
    logger.info(f"Writing to bronze table: {table_name}")

    writer = df.write.format("delta").mode(mode)

    if partition_columns:
        writer = writer.partitionBy(*partition_columns)

    writer.option("mergeSchema", "true").saveAsTable(table_name)

    logger.info(f"Successfully wrote to {table_name}")


def write_invalid_records(
    df: DataFrame,
    table_name: str,
) -> None:
    """Write invalid records to quarantine table."""
    if df.count() > 0:
        quarantine_table = f"{table_name}_quarantine"
        logger.info(f"Writing {df.count()} invalid records to {quarantine_table}")
        df.write.format("delta").mode("append").saveAsTable(quarantine_table)


def main():
    """Main entry point for bronze ingest."""

    # Parse arguments
    parser = argparse.ArgumentParser(description="Bronze layer ingest job")
    parser.add_argument("--source-path", required=True, help="Source data path")
    parser.add_argument("--batch-id", required=True, help="Batch identifier")
    parser.add_argument("--execution-date", help="Execution date (YYYY-MM-DD)")
    args = parser.parse_args()

    # Configuration from template
    config = {
        "pipeline_name": "{{ pipeline_name }}",
        "domain": "{{ domain }}",
        "bronze_table": "{{ bronze_table }}",
        "file_format": "{{ file_format | default('parquet', true) }}",
        "partition_columns": {{ partition_columns | default([], true) | tojson }},
        "source_path": args.source_path,
        "batch_id": args.batch_id,
    }

    logger.info(f"Starting bronze ingest for {config['pipeline_name']}")
    logger.info(f"Configuration: {config}")

    # Initialize Spark
    spark = SparkSession.builder \
        .appName(f"{config['pipeline_name']}_bronze_{config['batch_id']}") \
        .config("spark.sql.extensions", "io.delta.sql.DeltaSparkSessionExtension") \
        .config("spark.sql.catalog.spark_catalog", "org.apache.spark.sql.delta.catalog.DeltaCatalog") \
        .config("spark.databricks.delta.schema.autoMerge.enabled", "true") \
        .enableHiveSupport() \
        .getOrCreate()

    try:
        # Get schema
        schema = get_schema()

        # Read source data
        df = read_source_data(
            spark=spark,
            source_path=config["source_path"],
            file_format=config["file_format"],
            schema=schema if schema.fields else None,
        )

        # Validate data
        valid_df, invalid_df = validate_data(df)

        # Add audit columns
        bronze_df = add_audit_columns(
            df=valid_df,
            batch_id=config["batch_id"],
            source_path=config["source_path"],
        )

        # Write to bronze table
        write_to_bronze(
            df=bronze_df,
            table_name=config["bronze_table"],
            partition_columns=config["partition_columns"],
        )

        # Write invalid records to quarantine
        write_invalid_records(invalid_df, config["bronze_table"])

        # Log metrics
        metrics = {
            "records_read": df.count(),
            "records_valid": valid_df.count(),
            "records_invalid": invalid_df.count(),
            "batch_id": config["batch_id"],
        }
        logger.info(f"Bronze ingest complete. Metrics: {metrics}")

        return metrics

    except Exception as e:
        logger.error(f"Bronze ingest failed: {str(e)}", exc_info=True)
        raise
    finally:
        spark.stop()


if __name__ == "__main__":
    main()

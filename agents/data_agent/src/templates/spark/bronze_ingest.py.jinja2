{# Bronze Layer Ingest Spark Job Template #}
{# Ingests raw data from source to bronze layer with minimal transformation #}
{# Adds audit columns: _ingested_at, _source_file, _batch_id #}

"""
Bronze Layer Ingest: {{ pipeline_name }}
Domain: {{ domain }}
Source: {{ landing_path | default(source_path, true) }}
Target: {{ bronze_table }}
Format: {{ file_format | default('parquet', true) }}
Generated by: Data Agent
"""


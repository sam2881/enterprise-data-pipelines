{# SCD Type 2 Apply Spark Job Template #}
{# Implements Slowly Changing Dimension Type 2 logic #}
{# Tracks historical changes with effective date ranges #}

"""
SCD Type 2 Apply: {{ pipeline_name }}
Domain: {{ domain }}
Source: {{ silver_table }}
Target: {{ gold_table | default(silver_table ~ '_history', true) }}
Business Keys: {{ primary_keys | tojson }}
Generated by: Data Agent
"""

import sys
from datetime import datetime
from typing import List, Optional

from pyspark.sql import SparkSession, DataFrame, Window
from pyspark.sql import functions as F
from pyspark.sql.types import TimestampType, BooleanType
from delta.tables import DeltaTable
import logging
import argparse

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger("{{ pipeline_name }}_scd2")


# SCD2 Configuration
SCD2_CONFIG = {
    "source_table": "{{ silver_table }}",
    "target_table": "{{ gold_table | default(silver_table ~ '_history', true) }}",
    "business_keys": {{ primary_keys | tojson }},
    "tracked_columns": {{ scd2_tracked_columns | default([], true) | tojson }},
    "effective_from_column": "{{ scd2_effective_from | default('_effective_from', true) }}",
    "effective_to_column": "{{ scd2_effective_to | default('_effective_to', true) }}",
    "is_current_column": "{{ scd2_is_current | default('_is_current', true) }}",
    "hash_column": "_row_hash",
    "end_of_time": "{{ scd2_end_of_time | default('9999-12-31 23:59:59', true) }}",
}


def get_tracked_columns(df: DataFrame) -> List[str]:
    """
    Get columns to track for SCD2 changes.

    If tracked_columns is specified, use those.
    Otherwise, track all non-system columns.

    Args:
        df: Source DataFrame

    Returns:
        List of column names to track
    """
    if SCD2_CONFIG["tracked_columns"]:
        return SCD2_CONFIG["tracked_columns"]

    # Track all columns except system columns
    excluded = [
        "_ingested_at",
        "_source_file",
        "_batch_id",
        "_row_hash",
        "_silver_processed_at",
        "_silver_batch_id",
        "_dq_passed",
        "_dq_failures",
        "_merged_at",
        "_deleted",
        "_deleted_at",
        SCD2_CONFIG["effective_from_column"],
        SCD2_CONFIG["effective_to_column"],
        SCD2_CONFIG["is_current_column"],
    ]

    return [c for c in df.columns if c not in excluded]


def compute_row_hash(df: DataFrame, columns: List[str]) -> DataFrame:
    """
    Compute hash of tracked columns for change detection.

    Args:
        df: Input DataFrame
        columns: Columns to include in hash

    Returns:
        DataFrame with hash column
    """
    logger.info(f"Computing row hash from {len(columns)} columns")

    hash_cols = [F.coalesce(F.col(c).cast("string"), F.lit("NULL")) for c in columns]
    return df.withColumn(
        SCD2_CONFIG["hash_column"],
        F.sha2(F.concat_ws("|", *hash_cols), 256)
    )


def initialize_scd2_table(df: DataFrame, target_table: str) -> None:
    """
    Initialize SCD2 target table with first load.

    Sets all records as current with effective_from = current timestamp.

    Args:
        df: Source DataFrame
        target_table: Target table name
    """
    logger.info(f"Initializing SCD2 table: {target_table}")

    current_time = F.current_timestamp()
    end_of_time = F.lit(SCD2_CONFIG["end_of_time"]).cast(TimestampType())

    initial_df = df.withColumn(SCD2_CONFIG["effective_from_column"], current_time) \
                   .withColumn(SCD2_CONFIG["effective_to_column"], end_of_time) \
                   .withColumn(SCD2_CONFIG["is_current_column"], F.lit(True))

    initial_df.write \
        .format("delta") \
        .mode("overwrite") \
        .saveAsTable(target_table)

    logger.info(f"Initialized {target_table} with {initial_df.count()} records")


def identify_changes(
    source_df: DataFrame,
    target_df: DataFrame,
    business_keys: List[str],
    hash_column: str,
) -> tuple[DataFrame, DataFrame, DataFrame]:
    """
    Identify new, updated, and unchanged records.

    Args:
        source_df: Current source data
        target_df: Current target (only current records)
        business_keys: Business key columns
        hash_column: Column with row hash

    Returns:
        Tuple of (new_records, updated_records, unchanged_records)
    """
    logger.info("Identifying record changes")

    # Alias for join
    source = source_df.alias("source")
    target = target_df.alias("target")

    # Join on business keys
    join_condition = [F.col(f"source.{k}") == F.col(f"target.{k}") for k in business_keys]

    joined = source.join(target, join_condition, "left_outer")

    # New records - no match in target
    new_records = joined.filter(F.col(f"target.{business_keys[0]}").isNull()) \
                        .select([F.col(f"source.{c}").alias(c) for c in source_df.columns])

    # Matched records
    matched = joined.filter(F.col(f"target.{business_keys[0]}").isNotNull())

    # Updated records - hash changed
    updated_records = matched.filter(
        F.col(f"source.{hash_column}") != F.col(f"target.{hash_column}")
    ).select([F.col(f"source.{c}").alias(c) for c in source_df.columns])

    # Unchanged records - hash same
    unchanged_records = matched.filter(
        F.col(f"source.{hash_column}") == F.col(f"target.{hash_column}")
    ).select([F.col(f"source.{c}").alias(c) for c in source_df.columns])

    new_count = new_records.count()
    updated_count = updated_records.count()
    unchanged_count = unchanged_records.count()

    logger.info(f"Changes identified: {new_count} new, {updated_count} updated, {unchanged_count} unchanged")

    return new_records, updated_records, unchanged_records


def apply_scd2_changes(
    spark: SparkSession,
    new_records: DataFrame,
    updated_records: DataFrame,
    target_table: str,
    business_keys: List[str],
) -> dict:
    """
    Apply SCD2 changes to target table.

    1. Close existing records for updates (set effective_to, is_current=False)
    2. Insert new versions of updated records
    3. Insert completely new records

    Args:
        spark: SparkSession
        new_records: New records DataFrame
        updated_records: Updated records DataFrame
        target_table: Target table name
        business_keys: Business key columns

    Returns:
        Metrics dictionary
    """
    metrics = {
        "new_records_inserted": 0,
        "records_updated": 0,
        "versions_created": 0,
    }

    current_time = F.current_timestamp()
    end_of_time = F.lit(SCD2_CONFIG["end_of_time"]).cast(TimestampType())

    target = DeltaTable.forName(spark, target_table)

    # Step 1: Close existing records for updates
    if updated_records.count() > 0:
        logger.info(f"Closing {updated_records.count()} existing records")

        # Build merge condition
        merge_conditions = [
            f"target.{k} = source.{k}" for k in business_keys
        ]
        merge_condition = " AND ".join(merge_conditions) + f" AND target.{SCD2_CONFIG['is_current_column']} = true"

        # Close existing records
        target.alias("target").merge(
            updated_records.alias("source"),
            merge_condition
        ).whenMatchedUpdate(
            set={
                SCD2_CONFIG["effective_to_column"]: current_time,
                SCD2_CONFIG["is_current_column"]: F.lit(False),
            }
        ).execute()

        metrics["records_updated"] = updated_records.count()

    # Step 2: Insert new versions of updated records
    if updated_records.count() > 0:
        logger.info("Inserting new versions for updated records")

        new_versions = updated_records \
            .withColumn(SCD2_CONFIG["effective_from_column"], current_time) \
            .withColumn(SCD2_CONFIG["effective_to_column"], end_of_time) \
            .withColumn(SCD2_CONFIG["is_current_column"], F.lit(True))

        new_versions.write \
            .format("delta") \
            .mode("append") \
            .saveAsTable(target_table)

        metrics["versions_created"] = updated_records.count()

    # Step 3: Insert completely new records
    if new_records.count() > 0:
        logger.info(f"Inserting {new_records.count()} new records")

        initial_records = new_records \
            .withColumn(SCD2_CONFIG["effective_from_column"], current_time) \
            .withColumn(SCD2_CONFIG["effective_to_column"], end_of_time) \
            .withColumn(SCD2_CONFIG["is_current_column"], F.lit(True))

        initial_records.write \
            .format("delta") \
            .mode("append") \
            .saveAsTable(target_table)

        metrics["new_records_inserted"] = new_records.count()

    logger.info(f"SCD2 metrics: {metrics}")
    return metrics


def detect_deleted_records(
    source_df: DataFrame,
    target_df: DataFrame,
    business_keys: List[str],
) -> DataFrame:
    """
    Detect records that exist in target but not in source (deletes).

    Args:
        source_df: Current source data
        target_df: Current target data (only current records)
        business_keys: Business key columns

    Returns:
        DataFrame of deleted records
    """
    logger.info("Detecting deleted records")

    # Left anti join to find records in target not in source
    join_condition = [F.col(f"target.{k}") == F.col(f"source.{k}") for k in business_keys]

    deleted = target_df.alias("target").join(
        source_df.alias("source"),
        join_condition,
        "left_anti"
    )

    deleted_count = deleted.count()
    logger.info(f"Detected {deleted_count} deleted records")

    return deleted


def close_deleted_records(
    spark: SparkSession,
    deleted_records: DataFrame,
    target_table: str,
    business_keys: List[str],
) -> int:
    """
    Close deleted records in SCD2 table.

    Sets is_current=False and effective_to=current_timestamp.

    Args:
        spark: SparkSession
        deleted_records: DataFrame of records to close
        target_table: Target table name
        business_keys: Business key columns

    Returns:
        Number of records closed
    """
    if deleted_records.count() == 0:
        return 0

    logger.info(f"Closing {deleted_records.count()} deleted records")

    current_time = F.current_timestamp()
    target = DeltaTable.forName(spark, target_table)

    # Build merge condition
    merge_conditions = [f"target.{k} = source.{k}" for k in business_keys]
    merge_condition = " AND ".join(merge_conditions) + f" AND target.{SCD2_CONFIG['is_current_column']} = true"

    target.alias("target").merge(
        deleted_records.alias("source"),
        merge_condition
    ).whenMatchedUpdate(
        set={
            SCD2_CONFIG["effective_to_column"]: current_time,
            SCD2_CONFIG["is_current_column"]: F.lit(False),
            "_deleted": F.lit(True),
            "_deleted_at": current_time,
        }
    ).execute()

    return deleted_records.count()


def main():
    """Main entry point for SCD2 apply."""

    # Parse arguments
    parser = argparse.ArgumentParser(description="SCD2 apply job")
    parser.add_argument("--batch-id", required=True, help="Batch identifier")
    parser.add_argument("--execution-date", help="Execution date (YYYY-MM-DD)")
    parser.add_argument("--detect-deletes", action="store_true", help="Detect and close deleted records")
    args = parser.parse_args()

    # Configuration from template
    config = {
        "pipeline_name": "{{ pipeline_name }}",
        "domain": "{{ domain }}",
        "source_table": SCD2_CONFIG["source_table"],
        "target_table": SCD2_CONFIG["target_table"],
        "business_keys": SCD2_CONFIG["business_keys"],
        "batch_id": args.batch_id,
        "detect_deletes": args.detect_deletes,
    }

    logger.info(f"Starting SCD2 apply for {config['pipeline_name']}")
    logger.info(f"Configuration: {config}")

    # Initialize Spark with Delta Lake
    spark = SparkSession.builder \
        .appName(f"{config['pipeline_name']}_scd2_{config['batch_id']}") \
        .config("spark.sql.extensions", "io.delta.sql.DeltaSparkSessionExtension") \
        .config("spark.sql.catalog.spark_catalog", "org.apache.spark.sql.delta.catalog.DeltaCatalog") \
        .config("spark.databricks.delta.schema.autoMerge.enabled", "true") \
        .enableHiveSupport() \
        .getOrCreate()

    try:
        # Read source data
        logger.info(f"Reading source data from {config['source_table']}")
        source_df = spark.read.table(config["source_table"])

        source_count = source_df.count()
        logger.info(f"Read {source_count} records from source")

        if source_count == 0:
            logger.info("No source records to process")
            return {"records_processed": 0}

        # Get tracked columns and compute hash
        tracked_columns = get_tracked_columns(source_df)
        source_df = compute_row_hash(source_df, tracked_columns)

        # Check if target table exists
        try:
            target = DeltaTable.forName(spark, config["target_table"])
            table_exists = True
        except Exception:
            logger.info(f"Target table {config['target_table']} does not exist")
            table_exists = False

        if not table_exists:
            # Initialize table with first load
            initialize_scd2_table(source_df, config["target_table"])
            metrics = {
                "new_records_inserted": source_count,
                "records_updated": 0,
                "versions_created": 0,
                "records_deleted": 0,
            }
        else:
            # Read current records from target
            target_df = spark.read.table(config["target_table"]) \
                            .filter(F.col(SCD2_CONFIG["is_current_column"]) == True)

            # Identify changes
            new_records, updated_records, unchanged_records = identify_changes(
                source_df=source_df,
                target_df=target_df,
                business_keys=config["business_keys"],
                hash_column=SCD2_CONFIG["hash_column"],
            )

            # Apply SCD2 changes
            metrics = apply_scd2_changes(
                spark=spark,
                new_records=new_records,
                updated_records=updated_records,
                target_table=config["target_table"],
                business_keys=config["business_keys"],
            )

            # Optionally detect and close deleted records
            if config["detect_deletes"]:
                deleted_records = detect_deleted_records(
                    source_df=source_df,
                    target_df=target_df,
                    business_keys=config["business_keys"],
                )
                metrics["records_deleted"] = close_deleted_records(
                    spark=spark,
                    deleted_records=deleted_records,
                    target_table=config["target_table"],
                    business_keys=config["business_keys"],
                )
            else:
                metrics["records_deleted"] = 0

        # Log final metrics
        final_metrics = {
            "source_records": source_count,
            "new_records_inserted": metrics["new_records_inserted"],
            "records_updated": metrics["records_updated"],
            "versions_created": metrics["versions_created"],
            "records_deleted": metrics["records_deleted"],
            "batch_id": config["batch_id"],
        }
        logger.info(f"SCD2 apply complete. Metrics: {final_metrics}")

        return final_metrics

    except Exception as e:
        logger.error(f"SCD2 apply failed: {str(e)}", exc_info=True)
        raise
    finally:
        spark.stop()


if __name__ == "__main__":
    main()

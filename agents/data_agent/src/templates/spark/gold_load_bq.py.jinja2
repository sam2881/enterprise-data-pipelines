{# Gold Layer BigQuery Load Spark Job Template #}
{# Loads silver data to BigQuery for analytics/reporting #}
{# Supports append, overwrite, and partition-based writes #}

"""
Gold Layer BigQuery Load: {{ pipeline_name }}
Domain: {{ domain }}
Source: {{ silver_table }}
Target: {{ bigquery_dataset }}.{{ bigquery_table }}
Generated by: Data Agent
"""

import sys
from datetime import datetime
from typing import Optional

from pyspark.sql import SparkSession, DataFrame
from pyspark.sql import functions as F
from pyspark.sql.types import StructType
import logging
import argparse

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger("{{ pipeline_name }}_gold_bq")


# BigQuery configuration
BQ_CONFIG = {
    "project": "{{ gcp_project | default('your-gcp-project', true) }}",
    "dataset": "{{ bigquery_dataset }}",
    "table": "{{ bigquery_table }}",
    "temp_bucket": "{{ temp_gcs_bucket | default('dataproc-temp', true) }}",
    "write_method": "{{ bq_write_method | default('direct', true) }}",
}

# Columns to exclude from BigQuery (internal audit columns)
EXCLUDED_COLUMNS = [
    "_ingested_at",
    "_source_file",
    "_batch_id",
    "_row_hash",
    "_silver_processed_at",
    "_silver_batch_id",
    "_dq_passed",
    "_dq_failures",
]

# Partition configuration
PARTITION_CONFIG = {
    "enabled": {{ partition_by_date | default(true) | lower }},
    "field": "{{ partition_field | default('_load_date', true) }}",
    "type": "{{ partition_type | default('DAY', true) }}",
    "expiration_days": {{ partition_expiration_days | default(0) }},
}

# Clustering configuration
CLUSTERING_CONFIG = {
    "enabled": {{ clustering_enabled | default(false) | lower }},
    "columns": {{ clustering_columns | default([], true) | tojson }},
}


def prepare_for_bigquery(df: DataFrame) -> DataFrame:
    """
    Prepare DataFrame for BigQuery load.

    - Remove internal audit columns
    - Add load timestamp
    - Convert unsupported types
    - Handle null values

    Args:
        df: Input DataFrame

    Returns:
        Prepared DataFrame
    """
    logger.info("Preparing DataFrame for BigQuery")

    # Remove excluded columns
    columns_to_keep = [c for c in df.columns if c not in EXCLUDED_COLUMNS]
    df = df.select(*columns_to_keep)

    # Add load timestamp
    df = df.withColumn("_load_timestamp", F.current_timestamp())

    # Add load date for partitioning
    if PARTITION_CONFIG["enabled"]:
        partition_field = PARTITION_CONFIG["field"]
        if partition_field == "_load_date":
            df = df.withColumn("_load_date", F.current_date())

    # Handle complex types that BigQuery doesn't support well
    for field in df.schema.fields:
        # Convert array of structs to JSON string for compatibility
        if str(field.dataType).startswith("ArrayType(StructType"):
            df = df.withColumn(field.name, F.to_json(F.col(field.name)))

    return df


def get_write_options(write_mode: str, partition_field: Optional[str] = None) -> dict:
    """
    Get BigQuery write options.

    Args:
        write_mode: Write mode (append, overwrite, partition_overwrite)
        partition_field: Partition field for partition_overwrite mode

    Returns:
        Dictionary of write options
    """
    options = {
        "temporaryGcsBucket": BQ_CONFIG["temp_bucket"],
        "intermediateFormat": "parquet",
        "useAvroLogicalTypes": "true",
    }

    # Add partition options
    if PARTITION_CONFIG["enabled"]:
        options["partitionField"] = PARTITION_CONFIG["field"]
        options["partitionType"] = PARTITION_CONFIG["type"]

        if PARTITION_CONFIG["expiration_days"] > 0:
            options["partitionExpirationMs"] = str(
                PARTITION_CONFIG["expiration_days"] * 24 * 60 * 60 * 1000
            )

    # Add clustering options
    if CLUSTERING_CONFIG["enabled"] and CLUSTERING_CONFIG["columns"]:
        options["clusteredFields"] = ",".join(CLUSTERING_CONFIG["columns"])

    # Handle partition overwrite mode
    if write_mode == "partition_overwrite" and partition_field:
        options["partitionOverwriteMode"] = "DYNAMIC"

    return options


def write_to_bigquery(
    df: DataFrame,
    table_path: str,
    write_mode: str = "append",
    partition_filter: Optional[str] = None,
) -> None:
    """
    Write DataFrame to BigQuery.

    Args:
        df: DataFrame to write
        table_path: Full BigQuery table path (project.dataset.table)
        write_mode: Write mode (append, overwrite, partition_overwrite)
        partition_filter: Optional partition filter for overwrite
    """
    logger.info(f"Writing to BigQuery table: {table_path}")
    logger.info(f"Write mode: {write_mode}")
    logger.info(f"Record count: {df.count()}")

    # Get write options
    options = get_write_options(
        write_mode=write_mode,
        partition_field=PARTITION_CONFIG["field"] if PARTITION_CONFIG["enabled"] else None,
    )

    # Determine Spark write mode
    if write_mode == "overwrite":
        spark_mode = "overwrite"
    elif write_mode == "partition_overwrite":
        spark_mode = "overwrite"
        options["partitionOverwriteMode"] = "DYNAMIC"
    else:
        spark_mode = "append"

    # Write to BigQuery
    writer = df.write \
        .format("bigquery") \
        .option("table", table_path) \
        .mode(spark_mode)

    # Apply options
    for key, value in options.items():
        writer = writer.option(key, value)

    writer.save()

    logger.info(f"Successfully wrote to {table_path}")


def validate_bigquery_connection(spark: SparkSession, table_path: str) -> bool:
    """
    Validate BigQuery connection and table access.

    Args:
        spark: SparkSession
        table_path: Full BigQuery table path

    Returns:
        True if connection is valid
    """
    try:
        # Try to read table schema
        logger.info(f"Validating BigQuery connection to {table_path}")

        # Attempt minimal read to validate access
        test_df = spark.read \
            .format("bigquery") \
            .option("table", table_path) \
            .option("maxResults", "1") \
            .load()

        logger.info("BigQuery connection validated successfully")
        return True

    except Exception as e:
        # Table may not exist yet, which is fine for new tables
        if "NOT_FOUND" in str(e) or "not found" in str(e).lower():
            logger.info("Table does not exist yet, will be created")
            return True
        else:
            logger.error(f"BigQuery validation failed: {e}")
            raise


def calculate_metrics(df: DataFrame) -> dict:
    """Calculate load metrics for logging."""
    metrics = {
        "record_count": df.count(),
        "column_count": len(df.columns),
    }

    # Calculate approximate size
    # This is an estimate based on column count and record count
    estimated_size_mb = (metrics["record_count"] * metrics["column_count"] * 100) / (1024 * 1024)
    metrics["estimated_size_mb"] = round(estimated_size_mb, 2)

    return metrics


def main():
    """Main entry point for gold BigQuery load."""

    # Parse arguments
    parser = argparse.ArgumentParser(description="Gold layer BigQuery load job")
    parser.add_argument("--batch-id", required=True, help="Batch identifier")
    parser.add_argument("--execution-date", help="Execution date (YYYY-MM-DD)")
    parser.add_argument(
        "--write-mode",
        choices=["append", "overwrite", "partition_overwrite"],
        default="append",
        help="Write mode"
    )
    parser.add_argument("--partition-date", help="Partition date for overwrite")
    args = parser.parse_args()

    # Configuration from template
    config = {
        "pipeline_name": "{{ pipeline_name }}",
        "domain": "{{ domain }}",
        "silver_table": "{{ silver_table }}",
        "bq_project": BQ_CONFIG["project"],
        "bq_dataset": BQ_CONFIG["dataset"],
        "bq_table": BQ_CONFIG["table"],
        "batch_id": args.batch_id,
        "write_mode": args.write_mode,
        "partition_date": args.partition_date,
    }

    # Build full table path
    table_path = f"{config['bq_project']}.{config['bq_dataset']}.{config['bq_table']}"

    logger.info(f"Starting gold BigQuery load for {config['pipeline_name']}")
    logger.info(f"Configuration: {config}")
    logger.info(f"Target table: {table_path}")

    # Initialize Spark with BigQuery connector
    spark = SparkSession.builder \
        .appName(f"{config['pipeline_name']}_gold_bq_{config['batch_id']}") \
        .config("spark.sql.extensions", "io.delta.sql.DeltaSparkSessionExtension") \
        .config("spark.sql.catalog.spark_catalog", "org.apache.spark.sql.delta.catalog.DeltaCatalog") \
        .config("viewsEnabled", "true") \
        .config("materializationDataset", config["bq_dataset"]) \
        .enableHiveSupport() \
        .getOrCreate()

    try:
        # Validate BigQuery connection
        validate_bigquery_connection(spark, table_path)

        # Read from silver table
        logger.info(f"Reading from silver table: {config['silver_table']}")
        df = spark.read.table(config["silver_table"])

        record_count = df.count()
        logger.info(f"Read {record_count} records from silver")

        if record_count == 0:
            logger.info("No records to load")
            return {"records_loaded": 0}

        # Prepare for BigQuery
        df = prepare_for_bigquery(df)

        # Calculate pre-load metrics
        pre_metrics = calculate_metrics(df)
        logger.info(f"Pre-load metrics: {pre_metrics}")

        # Write to BigQuery
        write_to_bigquery(
            df=df,
            table_path=table_path,
            write_mode=config["write_mode"],
            partition_filter=config.get("partition_date"),
        )

        # Log final metrics
        metrics = {
            "records_loaded": pre_metrics["record_count"],
            "columns_loaded": pre_metrics["column_count"],
            "estimated_size_mb": pre_metrics["estimated_size_mb"],
            "target_table": table_path,
            "write_mode": config["write_mode"],
            "batch_id": config["batch_id"],
        }
        logger.info(f"Gold BigQuery load complete. Metrics: {metrics}")

        return metrics

    except Exception as e:
        logger.error(f"Gold BigQuery load failed: {str(e)}", exc_info=True)
        raise
    finally:
        spark.stop()


if __name__ == "__main__":
    main()

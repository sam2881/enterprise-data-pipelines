def apply_transformations(df: DataFrame) -> DataFrame:
    """
    Apply transformation rules from metadata.

    Supports:
    - rename: Rename column
    - cast: Cast to new type
    - trim: Trim whitespace
    - upper/lower: Case conversion
    - coalesce: Replace nulls with default
    - expression: Custom SQL expression
    - mask: Mask sensitive data
    - hash: Hash column value

    Args:
        df: Input DataFrame

    Returns:
        Transformed DataFrame
    """
    logger.info(f"Applying {len(TRANSFORMATION_RULES)} transformation rules")

    for rule in TRANSFORMATION_RULES:
        column = rule["column"]
        rule_type = rule["type"]
        expression = rule.get("expression", "")
        params = rule.get("params", {})

        try:
            if rule_type == "rename":
                new_name = params.get("new_name", expression)
                if column in df.columns:
                    df = df.withColumnRenamed(column, new_name)
                    logger.debug(f"Renamed {column} to {new_name}")

            elif rule_type == "cast":
                target_type = params.get("target_type", expression)
                if column in df.columns:
                    df = df.withColumn(column, F.col(column).cast(target_type))
                    logger.debug(f"Cast {column} to {target_type}")

            elif rule_type == "trim":
                if column in df.columns:
                    df = df.withColumn(column, F.trim(F.col(column)))
                    logger.debug(f"Trimmed {column}")

            elif rule_type == "upper":
                if column in df.columns:
                    df = df.withColumn(column, F.upper(F.col(column)))
                    logger.debug(f"Uppercased {column}")

            elif rule_type == "lower":
                if column in df.columns:
                    df = df.withColumn(column, F.lower(F.col(column)))
                    logger.debug(f"Lowercased {column}")

            elif rule_type == "coalesce":
                default_value = params.get("default", expression)
                if column in df.columns:
                    df = df.withColumn(column, F.coalesce(F.col(column), F.lit(default_value)))
                    logger.debug(f"Coalesced {column} with default {default_value}")

            elif rule_type == "expression":
                if expression:
                    df = df.withColumn(column, F.expr(expression))
                    logger.debug(f"Applied expression to {column}: {expression}")

            elif rule_type == "mask":
                mask_char = params.get("mask_char", "*")
                visible_chars = params.get("visible_chars", 4)
                if column in df.columns:
                    df = df.withColumn(
                        column,
                        F.concat(
                            F.lit(mask_char * 4),
                            F.right(F.col(column).cast("string"), visible_chars)
                        )
                    )
                    logger.debug(f"Masked {column}")

            elif rule_type == "hash":
                algorithm = params.get("algorithm", "sha2")
                if column in df.columns:
                    if algorithm == "sha2":
                        df = df.withColumn(column, F.sha2(F.col(column).cast("string"), 256))
                    elif algorithm == "md5":
                        df = df.withColumn(column, F.md5(F.col(column).cast("string")))
                    logger.debug(f"Hashed {column} with {algorithm}")

            elif rule_type == "extract_date":
                source_format = params.get("format", "yyyy-MM-dd")
                if column in df.columns:
                    df = df.withColumn(column, F.to_date(F.col(column), source_format))
                    logger.debug(f"Extracted date from {column}")

            elif rule_type == "concat":
                columns_to_concat = params.get("columns", [])
                separator = params.get("separator", "")
                if columns_to_concat:
                    concat_cols = [F.col(c) for c in columns_to_concat if c in df.columns]
                    if separator:
                        df = df.withColumn(column, F.concat_ws(separator, *concat_cols))
                    else:
                        df = df.withColumn(column, F.concat(*concat_cols))
                    logger.debug(f"Created {column} by concatenating {columns_to_concat}")

        except Exception as e:
            logger.error(f"Failed to apply rule {rule_type} on {column}: {e}")
            raise

    return df


def apply_data_quality_checks(df: DataFrame) -> tuple[DataFrame, dict]:
    """
    Apply data quality rules and filter/flag records.

    Supports:
    - not_null: Column must not be null
    - unique: Column values must be unique
    - range: Value must be within range
    - regex: Value must match pattern
    - in_set: Value must be in allowed set
    - custom: Custom SQL expression

    Args:
        df: Input DataFrame

    Returns:
        Tuple of (filtered_df, quality_metrics)
    """
    logger.info(f"Applying {len(DATA_QUALITY_RULES)} data quality rules")

    quality_metrics = {
        "total_records": df.count(),
        "rules_applied": len(DATA_QUALITY_RULES),
        "rules_passed": 0,
        "rules_failed": 0,
        "failures_by_rule": {},
    }

    # Add quality flag column
    df = df.withColumn("_dq_passed", F.lit(True))
    df = df.withColumn("_dq_failures", F.array())

    for rule in DATA_QUALITY_RULES:
        rule_name = rule["name"]
        rule_type = rule["type"]
        column = rule.get("column", "")
        expression = rule.get("expression", "")
        threshold = rule.get("threshold", 1.0)
        severity = rule.get("severity", "error")

        try:
            condition = None

            if rule_type == "not_null" and column in df.columns:
                condition = F.col(column).isNotNull()

            elif rule_type == "unique" and column in df.columns:
                # Count duplicates
                window = Window.partitionBy(column)
                df_with_count = df.withColumn("_dup_count", F.count("*").over(window))
                dup_count = df_with_count.filter(F.col("_dup_count") > 1).count()
                quality_metrics["failures_by_rule"][rule_name] = dup_count
                df = df_with_count.drop("_dup_count")
                if dup_count > 0:
                    logger.warning(f"Rule {rule_name}: Found {dup_count} duplicate values in {column}")
                continue

            elif rule_type == "range" and column in df.columns:
                min_val = rule.get("params", {}).get("min")
                max_val = rule.get("params", {}).get("max")
                if min_val is not None and max_val is not None:
                    condition = (F.col(column) >= min_val) & (F.col(column) <= max_val)
                elif min_val is not None:
                    condition = F.col(column) >= min_val
                elif max_val is not None:
                    condition = F.col(column) <= max_val

            elif rule_type == "regex" and column in df.columns:
                pattern = expression
                condition = F.col(column).rlike(pattern)

            elif rule_type == "in_set" and column in df.columns:
                allowed_values = rule.get("params", {}).get("values", [])
                condition = F.col(column).isin(allowed_values)

            elif rule_type == "custom" and expression:
                condition = F.expr(expression)

            elif rule_type == "length" and column in df.columns:
                min_len = rule.get("params", {}).get("min", 0)
                max_len = rule.get("params", {}).get("max", float("inf"))
                condition = (F.length(F.col(column)) >= min_len) & (F.length(F.col(column)) <= max_len)

            # Apply condition and track failures
            if condition is not None:
                failure_count = df.filter(~condition).count()
                quality_metrics["failures_by_rule"][rule_name] = failure_count

                if failure_count > 0:
                    failure_rate = failure_count / quality_metrics["total_records"]
                    if failure_rate > (1 - threshold):
                        logger.warning(
                            f"Rule {rule_name} failed: {failure_count} records "
                            f"({failure_rate:.2%}) exceed threshold {threshold}"
                        )
                        quality_metrics["rules_failed"] += 1

                        if severity == "error":
                            # Mark records as failed
                            df = df.withColumn(
                                "_dq_passed",
                                F.when(~condition, F.lit(False)).otherwise(F.col("_dq_passed"))
                            )
                            df = df.withColumn(
                                "_dq_failures",
                                F.when(
                                    ~condition,
                                    F.array_union(F.col("_dq_failures"), F.array(F.lit(rule_name)))
                                ).otherwise(F.col("_dq_failures"))
                            )
                    else:
                        quality_metrics["rules_passed"] += 1
                else:
                    quality_metrics["rules_passed"] += 1
                    logger.info(f"Rule {rule_name} passed: 0 failures")

        except Exception as e:
            logger.error(f"Failed to apply DQ rule {rule_name}: {e}")
            quality_metrics["rules_failed"] += 1

    # Calculate final metrics
    quality_metrics["records_passed"] = df.filter(F.col("_dq_passed")).count()
    quality_metrics["records_failed"] = quality_metrics["total_records"] - quality_metrics["records_passed"]

    logger.info(
        f"Data quality complete: {quality_metrics['records_passed']}/{quality_metrics['total_records']} passed"
    )

    return df, quality_metrics


def deduplicate(df: DataFrame, keys: list[str]) -> DataFrame:
    """
    Deduplicate records based on primary keys.

    Keeps the latest record based on _ingested_at timestamp.

    Args:
        df: Input DataFrame
        keys: Primary key columns

    Returns:
        Deduplicated DataFrame
    """
    if not keys:
        logger.info("No primary keys defined, skipping deduplication")
        return df

    logger.info(f"Deduplicating on keys: {keys}")

    # Window to get latest record per key
    window = Window.partitionBy(*keys).orderBy(F.desc("_ingested_at"))

    df_with_rank = df.withColumn("_row_rank", F.row_number().over(window))
    df_dedup = df_with_rank.filter(F.col("_row_rank") == 1).drop("_row_rank")

    original_count = df.count()
    dedup_count = df_dedup.count()
    removed = original_count - dedup_count

    logger.info(f"Removed {removed} duplicate records ({original_count} -> {dedup_count})")

    return df_dedup


def add_silver_audit_columns(df: DataFrame, batch_id: str) -> DataFrame:
    """Add silver layer audit columns."""
    return df.withColumn("_silver_processed_at", F.current_timestamp()) \
             .withColumn("_silver_batch_id", F.lit(batch_id))


def write_to_silver(
    df: DataFrame,
    table_name: str,
    partition_columns: list[str],
    mode: str = "overwrite",
) -> None:
    """
    Write DataFrame to silver Delta table.

    Args:
        df: DataFrame to write
        table_name: Target Delta table name
        partition_columns: Columns to partition by
        mode: Write mode (append, overwrite, merge)
    """
    logger.info(f"Writing to silver table: {table_name}")

    # Filter to only passed records
    passed_df = df.filter(F.col("_dq_passed"))

    writer = passed_df.write.format("delta").mode(mode)

    if partition_columns:
        writer = writer.partitionBy(*partition_columns)

    writer.option("mergeSchema", "true").saveAsTable(table_name)

    record_count = passed_df.count()
    logger.info(f"Wrote {record_count} records to {table_name}")


def write_failed_records(df: DataFrame, table_name: str) -> None:
    """Write DQ failed records to quarantine table."""
    failed_df = df.filter(~F.col("_dq_passed"))
    failed_count = failed_df.count()

    if failed_count > 0:
        quarantine_table = f"{table_name}_quarantine"
        logger.info(f"Writing {failed_count} failed records to {quarantine_table}")
        failed_df.write.format("delta").mode("append").saveAsTable(quarantine_table)


def main():
    """Main entry point for silver transform."""

    # Parse arguments
    parser = argparse.ArgumentParser(description="Silver layer transform job")
    parser.add_argument("--batch-id", required=True, help="Batch identifier")
    parser.add_argument("--execution-date", help="Execution date (YYYY-MM-DD)")
    parser.add_argument("--incremental", action="store_true", help="Incremental processing")
    args = parser.parse_args()

    # Configuration from template
    config = {
        "pipeline_name": "{{ pipeline_name }}",
        "domain": "{{ domain }}",
        "bronze_table": "{{ bronze_table }}",
        "silver_table": "{{ silver_table }}",
        "partition_columns": {{ partition_columns | default([], true) | tojson }},
        "primary_keys": PRIMARY_KEYS,
        "batch_id": args.batch_id,
        "incremental": args.incremental,
    }

    logger.info(f"Starting silver transform for {config['pipeline_name']}")
    logger.info(f"Configuration: {config}")

    # Initialize Spark
    spark = SparkSession.builder \
        .appName(f"{config['pipeline_name']}_silver_{config['batch_id']}") \
        .config("spark.sql.extensions", "io.delta.sql.DeltaSparkSessionExtension") \
        .config("spark.sql.catalog.spark_catalog", "org.apache.spark.sql.delta.catalog.DeltaCatalog") \
        .config("spark.databricks.delta.schema.autoMerge.enabled", "true") \
        .enableHiveSupport() \
        .getOrCreate()

    try:
        # Read from bronze
        logger.info(f"Reading from bronze table: {config['bronze_table']}")

        if config["incremental"]:
            # Read only new records based on batch_id
            df = spark.read.table(config["bronze_table"]) \
                      .filter(F.col("_batch_id") == config["batch_id"])
        else:
            df = spark.read.table(config["bronze_table"])

        record_count = df.count()
        logger.info(f"Read {record_count} records from bronze")

        if record_count == 0:
            logger.info("No records to process")
            return {"records_processed": 0}

        # Apply transformations
        df = apply_transformations(df)

        # Apply data quality checks
        df, quality_metrics = apply_data_quality_checks(df)

        # Deduplicate
        df = deduplicate(df, config["primary_keys"])

        # Add silver audit columns
        df = add_silver_audit_columns(df, config["batch_id"])

        # Write to silver
        write_to_silver(
            df=df,
            table_name=config["silver_table"],
            partition_columns=config["partition_columns"],
            mode="append" if config["incremental"] else "overwrite",
        )

        # Write failed records to quarantine
        write_failed_records(df, config["silver_table"])

        # Log final metrics
        metrics = {
            "records_read": record_count,
            "records_passed": quality_metrics["records_passed"],
            "records_failed": quality_metrics["records_failed"],
            "dq_rules_applied": quality_metrics["rules_applied"],
            "batch_id": config["batch_id"],
        }
        logger.info(f"Silver transform complete. Metrics: {metrics}")

        return metrics

    except Exception as e:
        logger.error(f"Silver transform failed: {str(e)}", exc_info=True)
        raise
    finally:
        spark.stop()


if __name__ == "__main__":
    main()

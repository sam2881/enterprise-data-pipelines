-- Insert Execution Record: {{ pipeline_name }}
-- Request ID: {{ request_id }}
-- Generated: {{ generated_at }}

BEGIN;

INSERT INTO execution (
    pipeline_id,
    request_id,
    execution_status,
    environment,
    triggered_by,
    artifacts_generated,
    branch_name,
    commit_sha,
    pr_url,
    cicd_build_id,
    started_at,
    created_at
) VALUES (
    {{ pipeline_id }},
    '{{ request_id }}',
    '{{ execution_status }}',
    '{{ environment }}',
    '{{ triggered_by }}',
    '{{ artifacts_generated | tojson }}',
    '{{ branch_name }}',
    '{{ commit_sha }}',
    {% if pr_url %}'{{ pr_url }}'{% else %}NULL{% endif %},
    '{{ cicd_build_id }}',
    NOW(),
    NOW()
)
RETURNING execution_id;

COMMIT;

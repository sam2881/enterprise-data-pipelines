{# CDC Merge Spark Job Template #}
{# Processes Change Data Capture events and merges into target Delta table #}
{# Supports INSERT, UPDATE, DELETE operations from CDC stream #}

"""
CDC Merge: {{ pipeline_name }}
Domain: {{ domain }}
Source: {{ cdc_topic | default(bronze_table, true) }}
Target: {{ silver_table }}
Merge Keys: {{ merge_keys | default(primary_keys, true) | tojson }}
Generated by: Data Agent
"""

import sys
from datetime import datetime
from typing import List, Optional

from pyspark.sql import SparkSession, DataFrame
from pyspark.sql import functions as F
from pyspark.sql.window import Window
from delta.tables import DeltaTable
import logging
import argparse

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger("{{ pipeline_name }}_cdc_merge")


# CDC Configuration
CDC_CONFIG = {
    "source_table": "{{ bronze_table }}",
    "target_table": "{{ silver_table }}",
    "merge_keys": {{ merge_keys | default(primary_keys, true) | tojson }},
    "operation_column": "{{ cdc_operation_column | default('_op', true) }}",
    "timestamp_column": "{{ cdc_timestamp_column | default('_ts', true) }}",
    "delete_operation": "{{ cdc_delete_value | default('d', true) }}",
    "insert_operation": "{{ cdc_insert_value | default('c', true) }}",
    "update_operation": "{{ cdc_update_value | default('u', true) }}",
    "read_operation": "{{ cdc_read_value | default('r', true) }}",
}

# Columns to exclude from merge (CDC metadata columns)
EXCLUDED_COLUMNS = [
    "_op",
    "_ts",
    "_source",
    "_pos",
    "_file",
    "_line",
    "_batch_id",
    "_ingested_at",
]


def build_merge_condition(keys: List[str]) -> str:
    """
    Build merge condition string from key columns.

    Args:
        keys: List of primary key column names

    Returns:
        Merge condition string for Delta merge
    """
    conditions = [f"target.{key} = source.{key}" for key in keys]
    return " AND ".join(conditions)


def deduplicate_cdc_events(df: DataFrame, keys: List[str], ts_column: str) -> DataFrame:
    """
    Deduplicate CDC events keeping only the latest per key.

    When multiple events exist for the same key in a batch,
    keep only the one with the latest timestamp.

    Args:
        df: DataFrame with CDC events
        keys: Primary key columns
        ts_column: Timestamp column for ordering

    Returns:
        Deduplicated DataFrame
    """
    logger.info("Deduplicating CDC events")

    # Window to get latest event per key
    window = Window.partitionBy(*keys).orderBy(F.desc(ts_column))

    df_with_rank = df.withColumn("_cdc_rank", F.row_number().over(window))
    df_dedup = df_with_rank.filter(F.col("_cdc_rank") == 1).drop("_cdc_rank")

    original_count = df.count()
    dedup_count = df_dedup.count()

    logger.info(f"Deduplicated {original_count - dedup_count} events ({original_count} -> {dedup_count})")

    return df_dedup


def prepare_source_data(df: DataFrame) -> DataFrame:
    """
    Prepare source DataFrame for merge operation.

    - Removes CDC metadata columns
    - Adds processing timestamp
    - Handles null values

    Args:
        df: Source DataFrame with CDC events

    Returns:
        Prepared DataFrame
    """
    logger.info("Preparing source data for merge")

    # Get columns to keep (exclude CDC metadata)
    columns_to_keep = [c for c in df.columns if c not in EXCLUDED_COLUMNS and not c.startswith("_cdc")]

    # Also keep operation column for conditional logic
    if CDC_CONFIG["operation_column"] in df.columns:
        columns_to_keep.append(CDC_CONFIG["operation_column"])

    df = df.select(*columns_to_keep)

    # Add merge timestamp
    df = df.withColumn("_merged_at", F.current_timestamp())

    return df


def execute_merge(
    spark: SparkSession,
    source_df: DataFrame,
    target_table: str,
    merge_keys: List[str],
    operation_column: str,
    delete_value: str,
) -> dict:
    """
    Execute Delta Lake merge operation.

    Handles:
    - INSERT (new records)
    - UPDATE (changed records)
    - DELETE (soft or hard delete based on config)

    Args:
        spark: SparkSession
        source_df: Source DataFrame with CDC events
        target_table: Target Delta table name
        merge_keys: Primary key columns for matching
        operation_column: Column indicating CDC operation type
        delete_value: Value indicating delete operation

    Returns:
        Metrics dictionary
    """
    logger.info(f"Executing merge into {target_table}")

    metrics = {
        "records_inserted": 0,
        "records_updated": 0,
        "records_deleted": 0,
    }

    # Check if target table exists
    try:
        target = DeltaTable.forName(spark, target_table)
        table_exists = True
    except Exception:
        logger.info(f"Target table {target_table} does not exist, will be created")
        table_exists = False

    if not table_exists:
        # Create table with first batch
        initial_df = source_df.filter(
            F.col(operation_column) != delete_value
        ).drop(operation_column)

        initial_df.write \
            .format("delta") \
            .mode("overwrite") \
            .saveAsTable(target_table)

        metrics["records_inserted"] = initial_df.count()
        logger.info(f"Created table with {metrics['records_inserted']} records")
        return metrics

    # Build merge condition
    merge_condition = build_merge_condition(merge_keys)

    # Separate deletes from upserts
    deletes_df = source_df.filter(F.col(operation_column) == delete_value)
    upserts_df = source_df.filter(F.col(operation_column) != delete_value)

    # Get columns to update (exclude merge keys and operation column)
    update_columns = {
        col: f"source.{col}"
        for col in source_df.columns
        if col not in merge_keys and col != operation_column
    }

    # Execute upsert merge
    if upserts_df.count() > 0:
        logger.info(f"Processing {upserts_df.count()} upsert events")

        upserts_df = upserts_df.drop(operation_column)

        merge_builder = target.alias("target").merge(
            upserts_df.alias("source"),
            merge_condition
        )

        # When matched - update all columns
        merge_builder = merge_builder.whenMatchedUpdate(
            set={col: F.col(f"source.{col}") for col in upserts_df.columns if col not in merge_keys}
        )

        # When not matched - insert new record
        merge_builder = merge_builder.whenNotMatchedInsertAll()

        # Execute merge
        merge_builder.execute()

        # Get metrics from Delta history
        history = spark.sql(f"DESCRIBE HISTORY {target_table} LIMIT 1").collect()[0]
        operation_metrics = history.operationMetrics or {}

        metrics["records_inserted"] = int(operation_metrics.get("numTargetRowsInserted", 0))
        metrics["records_updated"] = int(operation_metrics.get("numTargetRowsUpdated", 0))

    # Execute delete merge
    if deletes_df.count() > 0:
        logger.info(f"Processing {deletes_df.count()} delete events")

        {% if soft_delete | default(true) %}
        # Soft delete - mark records as deleted
        delete_condition = build_merge_condition(merge_keys)

        target.alias("target").merge(
            deletes_df.alias("source"),
            delete_condition
        ).whenMatchedUpdate(
            set={
                "_deleted": F.lit(True),
                "_deleted_at": F.current_timestamp(),
            }
        ).execute()

        metrics["records_deleted"] = deletes_df.count()
        {% else %}
        # Hard delete - remove records
        for row in deletes_df.select(*merge_keys).collect():
            delete_condition = " AND ".join([
                f"{key} = '{row[key]}'" for key in merge_keys
            ])
            target.delete(delete_condition)
            metrics["records_deleted"] += 1
        {% endif %}

    logger.info(f"Merge metrics: {metrics}")
    return metrics


def validate_cdc_schema(df: DataFrame) -> bool:
    """
    Validate that DataFrame has required CDC columns.

    Args:
        df: DataFrame to validate

    Returns:
        True if valid
    """
    required_columns = [CDC_CONFIG["operation_column"]]

    missing = [c for c in required_columns if c not in df.columns]

    if missing:
        logger.error(f"Missing required CDC columns: {missing}")
        return False

    return True


def main():
    """Main entry point for CDC merge."""

    # Parse arguments
    parser = argparse.ArgumentParser(description="CDC merge job")
    parser.add_argument("--batch-id", required=True, help="Batch identifier")
    parser.add_argument("--execution-date", help="Execution date (YYYY-MM-DD)")
    parser.add_argument("--source-path", help="Override source path")
    args = parser.parse_args()

    # Configuration from template
    config = {
        "pipeline_name": "{{ pipeline_name }}",
        "domain": "{{ domain }}",
        "source_table": CDC_CONFIG["source_table"],
        "target_table": CDC_CONFIG["target_table"],
        "merge_keys": CDC_CONFIG["merge_keys"],
        "operation_column": CDC_CONFIG["operation_column"],
        "timestamp_column": CDC_CONFIG["timestamp_column"],
        "delete_value": CDC_CONFIG["delete_operation"],
        "batch_id": args.batch_id,
    }

    logger.info(f"Starting CDC merge for {config['pipeline_name']}")
    logger.info(f"Configuration: {config}")

    # Initialize Spark with Delta Lake
    spark = SparkSession.builder \
        .appName(f"{config['pipeline_name']}_cdc_merge_{config['batch_id']}") \
        .config("spark.sql.extensions", "io.delta.sql.DeltaSparkSessionExtension") \
        .config("spark.sql.catalog.spark_catalog", "org.apache.spark.sql.delta.catalog.DeltaCatalog") \
        .config("spark.databricks.delta.schema.autoMerge.enabled", "true") \
        .enableHiveSupport() \
        .getOrCreate()

    try:
        # Read CDC events from source
        logger.info(f"Reading CDC events from {config['source_table']}")

        if args.source_path:
            df = spark.read.format("delta").load(args.source_path)
        else:
            df = spark.read.table(config["source_table"])

        # Filter to current batch
        df = df.filter(F.col("_batch_id") == config["batch_id"])

        event_count = df.count()
        logger.info(f"Read {event_count} CDC events")

        if event_count == 0:
            logger.info("No CDC events to process")
            return {"events_processed": 0}

        # Validate CDC schema
        if not validate_cdc_schema(df):
            raise ValueError("Invalid CDC schema")

        # Deduplicate events
        df = deduplicate_cdc_events(
            df=df,
            keys=config["merge_keys"],
            ts_column=config["timestamp_column"],
        )

        # Prepare source data
        df = prepare_source_data(df)

        # Execute merge
        metrics = execute_merge(
            spark=spark,
            source_df=df,
            target_table=config["target_table"],
            merge_keys=config["merge_keys"],
            operation_column=config["operation_column"],
            delete_value=config["delete_value"],
        )

        # Log final metrics
        final_metrics = {
            "events_read": event_count,
            "events_deduplicated": df.count(),
            "records_inserted": metrics["records_inserted"],
            "records_updated": metrics["records_updated"],
            "records_deleted": metrics["records_deleted"],
            "batch_id": config["batch_id"],
        }
        logger.info(f"CDC merge complete. Metrics: {final_metrics}")

        return final_metrics

    except Exception as e:
        logger.error(f"CDC merge failed: {str(e)}", exc_info=True)
        raise
    finally:
        spark.stop()


if __name__ == "__main__":
    main()
